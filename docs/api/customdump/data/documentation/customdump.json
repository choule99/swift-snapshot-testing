{"abstract":[{"text":"A collection of tools for debugging, diffing, and testing your application’s data structures.","type":"text"}],"hierarchy":{"paths":[[]]},"variants":[{"paths":["\/documentation\/customdump"],"traits":[{"interfaceLanguage":"swift"}]}],"schemaVersion":{"major":0,"patch":0,"minor":3},"metadata":{"modules":[{"name":"CustomDump"}],"title":"CustomDump","externalID":"CustomDump","roleHeading":"Framework","symbolKind":"module","role":"collection"},"sections":[],"kind":"symbol","identifier":{"url":"doc:\/\/CustomDump\/documentation\/CustomDump","interfaceLanguage":"swift"},"topicSections":[{"identifiers":["doc:\/\/CustomDump\/documentation\/CustomDump\/customDump(_:name:indent:maxDepth:)","doc:\/\/CustomDump\/documentation\/CustomDump\/customDump(_:to:name:indent:maxDepth:)"],"anchor":"Dumping","title":"Dumping"},{"identifiers":["doc:\/\/CustomDump\/documentation\/CustomDump\/diff(_:_:format:)"],"anchor":"Diffing","title":"Diffing"},{"identifiers":["doc:\/\/CustomDump\/documentation\/CustomDump\/expectNoDifference(_:_:_:fileID:filePath:line:column:)"],"anchor":"Test-support","title":"Test support"},{"identifiers":["doc:\/\/CustomDump\/documentation\/CustomDump\/CustomDumpStringConvertible","doc:\/\/CustomDump\/documentation\/CustomDump\/CustomDumpRepresentable","doc:\/\/CustomDump\/documentation\/CustomDump\/CustomDumpReflectable"],"anchor":"Customizing-output","title":"Customizing output"},{"identifiers":["doc:\/\/CustomDump\/documentation\/CustomDump\/expectDifference(_:_:operation:changes:fileID:filePath:line:column:)-1tzip","doc:\/\/CustomDump\/documentation\/CustomDump\/expectDifference(_:_:operation:changes:fileID:filePath:line:column:)-4f9bh"],"anchor":"Functions","generated":true,"title":"Functions"},{"identifiers":["doc:\/\/CustomDump\/documentation\/CustomDump\/CoreImage","doc:\/\/CustomDump\/documentation\/CustomDump\/CoreLocation","doc:\/\/CustomDump\/documentation\/CustomDump\/CoreMotion","doc:\/\/CustomDump\/documentation\/CustomDump\/Foundation","doc:\/\/CustomDump\/documentation\/CustomDump\/Photos","doc:\/\/CustomDump\/documentation\/CustomDump\/Speech","doc:\/\/CustomDump\/documentation\/CustomDump\/StoreKit","doc:\/\/CustomDump\/documentation\/CustomDump\/Swift","doc:\/\/CustomDump\/documentation\/CustomDump\/SwiftUICore","doc:\/\/CustomDump\/documentation\/CustomDump\/UniformTypeIdentifiers","doc:\/\/CustomDump\/documentation\/CustomDump\/UserNotifications","doc:\/\/CustomDump\/documentation\/CustomDump\/UserNotificationsUI","doc:\/\/CustomDump\/documentation\/CustomDump\/_LocationEssentials"],"anchor":"Extended-Modules","generated":true,"title":"Extended Modules"}],"primaryContentSections":[{"content":[{"text":"Overview","anchor":"Overview","level":2,"type":"heading"},{"inlineContent":[{"text":"Swift comes with a wonderful tool for dumping the contents of any value to a string, and it’s called","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"dump"},{"text":". It prints all the fields and sub-fields of a value into a tree-like description:","type":"text"}],"type":"paragraph"},{"code":["struct User {","  var favoriteNumbers: [Int]","  var id: Int","  var name: String","}","","let user = User(","  favoriteNumbers: [42, 1729],","  id: 2,","  name: \"Blob\"",")","","dump(user)"],"syntax":"swift","type":"codeListing"},{"code":["▿ User","  ▿ favoriteNumbers: 2 elements","    - 42","    - 1729","  - id: 2","  - name: \"Blob\""],"syntax":"text","type":"codeListing"},{"inlineContent":[{"text":"This is really useful, and can be great for building debug tools that visualize the data held in","type":"text"},{"text":" ","type":"text"},{"text":"runtime values of our applications, but sometimes its output is not ideal.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"For example, dumping dictionaries leads to a verbose output that can be hard to read (also note that","type":"text"},{"text":" ","type":"text"},{"text":"the keys are unordered):","type":"text"}],"type":"paragraph"},{"code":["dump([1: \"one\", 2: \"two\", 3: \"three\"])"],"syntax":"swift","type":"codeListing"},{"code":["▿ 3 key\/value pairs","  ▿ (2 elements)","    - key: 2","    - value: \"two\"","  ▿ (2 elements)","    - key: 3","    - value: \"three\"","  ▿ (2 elements)","    - key: 1","    - value: \"one\""],"syntax":"text","type":"codeListing"},{"inlineContent":[{"text":"Similarly enums have a very verbose output:","type":"text"}],"type":"paragraph"},{"code":["dump(Result<Int, Error>.success(42))"],"syntax":"swift","type":"codeListing"},{"code":["▿ Swift.Result<Swift.Int, Swift.Error>.success","  - success: 42"],"syntax":"text","type":"codeListing"},{"inlineContent":[{"text":"It gets even harder to read when dealing with deeply nested structures:","type":"text"}],"type":"paragraph"},{"code":["dump([1: Result<User, Error>.success(user)])"],"syntax":"swift","type":"codeListing"},{"code":["▿ 1 key\/value pair","  ▿ (2 elements)","    - key: 1","    ▿ value: Swift.Result<User, Swift.Error>.success","      ▿ success: User","        ▿ favoriteNumbers: 2 elements","          - 42","          - 1729","        - id: 2","        - name: \"Blob\""],"syntax":"text","type":"codeListing"},{"inlineContent":[{"text":"There are also times that ","type":"text"},{"type":"codeVoice","code":"dump"},{"text":" simply does not print useful information, such as enums imported","type":"text"},{"text":" ","type":"text"},{"text":"from Objective-C:","type":"text"}],"type":"paragraph"},{"code":["import UserNotifications","","dump(UNNotificationSetting.disabled)"],"syntax":"swift","type":"codeListing"},{"code":["- __C.UNNotificationSetting"],"syntax":"text","type":"codeListing"},{"inlineContent":[{"text":"So, while the ","type":"text"},{"type":"codeVoice","code":"dump"},{"text":" function can be handy, it is often too crude of a tool to use. This is the","type":"text"},{"text":" ","type":"text"},{"text":"motivation for the ","type":"text"},{"type":"codeVoice","code":"customDump"},{"text":" function.","type":"text"}],"type":"paragraph"},{"text":"customDump","anchor":"customDump","level":3,"type":"heading"},{"inlineContent":[{"text":"The ","type":"text"},{"identifier":"doc:\/\/CustomDump\/documentation\/CustomDump\/customDump(_:name:indent:maxDepth:)","type":"reference","isActive":true},{"text":" function emulates the behavior of ","type":"text"},{"type":"codeVoice","code":"dump"},{"text":", but provides a","type":"text"},{"text":" ","type":"text"},{"text":"more refined output of nested structures, optimizing for readability. For example, structs are","type":"text"},{"text":" ","type":"text"},{"text":"dumped in a format that more closely mimics the struct syntax in Swift, and arrays are dumped with","type":"text"},{"text":" ","type":"text"},{"text":"the indices of each element:","type":"text"}],"type":"paragraph"},{"code":["import CustomDump","","customDump(user)"],"syntax":"swift","type":"codeListing"},{"code":["User(","  favoriteNumbers: [","    [0]: 42,","    [1]: 1729","  ],","  id: 2,","  name: \"Blob\"",")"],"syntax":"text","type":"codeListing"},{"inlineContent":[{"text":"Dictionaries are dumped in a more compact format that mimics Swift’s syntax, and automatically","type":"text"},{"text":" ","type":"text"},{"text":"orders the keys:","type":"text"}],"type":"paragraph"},{"code":["customDump([1: \"one\", 2: \"two\", 3: \"three\"])"],"syntax":"swift","type":"codeListing"},{"code":["[","  1: \"one\",","  2: \"two\",","  3: \"three\"","]"],"syntax":"text","type":"codeListing"},{"inlineContent":[{"text":"Similarly, enums also dump in a more compact, readable format:","type":"text"}],"type":"paragraph"},{"code":["customDump(Result<Int, Error>.success(42))"],"syntax":"swift","type":"codeListing"},{"code":["Result.success(42)"],"syntax":"text","type":"codeListing"},{"inlineContent":[{"text":"And deeply nested structures have a simplified tree-structure:","type":"text"}],"type":"paragraph"},{"code":["customDump([1: Result<User, Error>.success(user)])"],"syntax":"swift","type":"codeListing"},{"code":["[","  1: Result.success(","    User(","      favoriteNumbers: [","        [0]: 42,","        [1]: 1729","      ],","      id: 2,","      name: \"Blob\"","    )","  )","]"],"syntax":"text","type":"codeListing"},{"text":"diff","anchor":"diff","level":3,"type":"heading"},{"inlineContent":[{"text":"Using the output of the ","type":"text"},{"type":"codeVoice","code":"customDump"},{"text":" function we can build a very lightweight way to textually diff","type":"text"},{"text":" ","type":"text"},{"text":"any two values in Swift using the ","type":"text"},{"identifier":"doc:\/\/CustomDump\/documentation\/CustomDump\/diff(_:_:format:)","type":"reference","isActive":true},{"text":" function:","type":"text"}],"type":"paragraph"},{"code":["var other = user","other.favoriteNumbers[1] = 91","","print(diff(user, other)!)"],"syntax":"swift","type":"codeListing"},{"code":["  User(","    favoriteNumbers: [","      [0]: 42,","-     [1]: 1729","+     [1]: 91","    ],","    id: 2,","    name: \"Blob\"","  )"],"syntax":"diff","type":"codeListing"},{"inlineContent":[{"text":"Further, extra work is done to minimize the size of the diff when parts of the structure haven’t","type":"text"},{"text":" ","type":"text"},{"text":"changed, such as a single element changing in a large collection:","type":"text"}],"type":"paragraph"},{"code":["let users = (1...5).map {","  User(","    favoriteNumbers: [$0],","    id: $0,","    name: \"Blob \\($0)\"","  )","}","","var other = users","other.append(","  .init(","    favoriteNumbers: [42, 1729],","    id: 100,","    name: \"Blob Sr.\"","  )",")","","print(diff(users, other)!)"],"syntax":"swift","type":"codeListing"},{"code":["  [","    … (4 unchanged),","+   [4]: User(","+     favoriteNumbers: [","+       [0]: 42,","+       [1]: 1729","+     ],","+     id: 100,","+     name: \"Blob Sr.\"","+   )","  ]"],"syntax":"diff","type":"codeListing"},{"inlineContent":[{"text":"For a real world use case we modified Apple’s","type":"text"},{"text":" ","type":"text"},{"identifier":"https:\/\/developer.apple.com\/tutorials\/swiftui\/working-with-ui-controls","type":"reference","isActive":true},{"text":" tutorial","type":"text"},{"text":" ","type":"text"},{"text":"application to print the before and after state when favoriting a landmark:","type":"text"}],"type":"paragraph"},{"code":["  [","    [0]: Landmark(","      id: 1001,","      name: \"Turtle Rock\",","      park: \"Joshua Tree National Park\",","      state: \"California\",","      description: \"This very large formation lies south of the large Real Hidden Valley parking lot and immediately adjacent to (south of) the picnic areas.\",","-     isFavorite: true,","+     isFavorite: false,","      isFeatured: true,","      category: Category.rivers,","      imageName: \"turtlerock\",","      coordinates: Coordinates(…)","    ),","    … (11 unchanged)","  ]"],"syntax":"diff","type":"codeListing"},{"text":"expectNoDifference","anchor":"expectNoDifference","level":3,"type":"heading"},{"inlineContent":[{"text":"The ","type":"text"},{"type":"codeVoice","code":"XCTAssertEqual"},{"text":" function from ","type":"text"},{"type":"codeVoice","code":"XCTest"},{"text":" allows you to assert that two values are equal, and if","type":"text"},{"text":" ","type":"text"},{"text":"they are not the test suite will fail with a message:","type":"text"}],"type":"paragraph"},{"code":["var other = user","other.name += \"!\"","","XCTAssertEqual(user, other)"],"syntax":"swift","type":"codeListing"},{"code":["XCTAssertEqual failed: (\"User(favoriteNumbers: [42, 1729], id: 2, name: \"Blob\")\") is not equal to (\"User(favoriteNumbers: [42, 1729], id: 2, name: \"Blob!\")\")"],"syntax":"text","type":"codeListing"},{"inlineContent":[{"text":"Unfortunately this failure message is quite difficult to visually parse and understand. It takes a","type":"text"},{"text":" ","type":"text"},{"text":"few moments of hunting through the message to see that the only difference is the exclamation mark","type":"text"},{"text":" ","type":"text"},{"text":"at the end of the name. The problem gets worse if the type is more complex, consisting of nested","type":"text"},{"text":" ","type":"text"},{"text":"structures and large collections.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"This library also ships with an ","type":"text"},{"type":"codeVoice","code":"expectNoDifference(_:_:_:file:line:)"},{"text":" function to mitigate","type":"text"},{"text":" ","type":"text"},{"text":"these problems. It works like ","type":"text"},{"type":"codeVoice","code":"XCTAssertEqual"},{"text":" except the failure message uses a nicely formatted","type":"text"},{"text":" ","type":"text"},{"text":"diff to show exactly what is different between the two values:","type":"text"}],"type":"paragraph"},{"code":["expectNoDifference(user, other)"],"syntax":"swift","type":"codeListing"},{"code":["expectNoDifference failed: …","","  User(","    favoriteNumbers: […],","    id: 2,","-   name: \"Blob\"","+   name: \"Blob!\"","  )","","(First: -, Second: +)"],"syntax":"diff","type":"codeListing"},{"text":"expectDifference","anchor":"expectDifference","level":3,"type":"heading"},{"inlineContent":[{"type":"codeVoice","code":"expectDifference(_:_:operation:changes:file:line:)-8xfxw"},{"text":" provides the inverse of","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"expectNoDifference"},{"text":": it asserts that a value has a set of changes by evaluating a given","type":"text"},{"text":" ","type":"text"},{"text":"expression before and after a given operation and then comparing the results.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"For example, given a very simple counter structure, we can write a test against its incrementing","type":"text"},{"text":" ","type":"text"},{"text":"functionality:","type":"text"}],"type":"paragraph"},{"code":["struct Counter {","  var count = 0","  var isOdd = false","  mutating func increment() {","    self.count += 1","    self.isOdd.toggle()","  }","}","","var counter = Counter()","expectDifference(counter) {","  counter.increment()","} changes: {","  $0.count = 1","  $0.isOdd = true","}"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"text":"If the ","type":"text"},{"type":"codeVoice","code":"changes"},{"text":" does not exhaustively describe all changed fields, the assertion will fail.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"By omitting the operation you can write a “non-exhaustive” assertion against a value by describing","type":"text"},{"text":" ","type":"text"},{"text":"just the fields you want to assert against in the ","type":"text"},{"type":"codeVoice","code":"changes"},{"text":" closure:","type":"text"}],"type":"paragraph"},{"code":["counter.increment()","expectDifference(counter) {","  $0.count = 1","  \/\/ Don't need to further describe how `isOdd` has changed","}"],"syntax":"swift","type":"codeListing"},{"text":"Customization","anchor":"Customization","level":2,"type":"heading"},{"inlineContent":[{"text":"Custom Dump provides a few important ways to customize how a data type is dumped:","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/CustomDump\/documentation\/CustomDump\/CustomDumpStringConvertible","type":"reference","isActive":true},{"text":", ","type":"text"},{"identifier":"doc:\/\/CustomDump\/documentation\/CustomDump\/CustomDumpReflectable","type":"reference","isActive":true},{"text":", and ","type":"text"},{"identifier":"doc:\/\/CustomDump\/documentation\/CustomDump\/CustomDumpRepresentable","type":"reference","isActive":true},{"text":".","type":"text"}],"type":"paragraph"},{"text":"CustomDumpStringConvertible","anchor":"CustomDumpStringConvertible","level":3,"type":"heading"},{"inlineContent":[{"text":"The ","type":"text"},{"identifier":"doc:\/\/CustomDump\/documentation\/CustomDump\/CustomDumpStringConvertible","type":"reference","isActive":true},{"text":" protocol provides a simple way of converting a type to a raw","type":"text"},{"text":" ","type":"text"},{"text":"string for the purpose of dumping. It is most appropriate for types that have a simple, un-nested","type":"text"},{"text":" ","type":"text"},{"text":"internal representation, and typically its output fits on a single line, for example dates, UUIDs,","type":"text"},{"text":" ","type":"text"},{"text":"URLs, etc:","type":"text"}],"type":"paragraph"},{"code":["extension URL: CustomDumpStringConvertible {","  public var customDumpDescription: String {","    \"URL(\\(self.absoluteString))\"","  }","}","","customDump(URL(string: \"https:\/\/www.pointfree.co\/\")!)"],"syntax":"swift","type":"codeListing"},{"code":["URL(https:\/\/www.pointfree.co\/)"],"syntax":"text","type":"codeListing"},{"inlineContent":[{"text":"Custom Dump also uses this protocol internally to provide more useful output for enums imported from","type":"text"},{"text":" ","type":"text"},{"text":"Objective-C:","type":"text"}],"type":"paragraph"},{"code":["import UserNotifications","","print(\"dump:\")","dump(UNNotificationSetting.disabled)","print(\"customDump:\")","customDump(UNNotificationSetting.disabled)"],"syntax":"swift","type":"codeListing"},{"code":["dump:","- __C.UNNotificationSetting","customDump:","UNNotificationSettings.disabled"],"syntax":"text","type":"codeListing"},{"text":"CustomDumpReflectable","anchor":"CustomDumpReflectable","level":3,"type":"heading"},{"inlineContent":[{"text":"The ","type":"text"},{"identifier":"doc:\/\/CustomDump\/documentation\/CustomDump\/CustomDumpReflectable","type":"reference","isActive":true},{"text":" protocol provides a more comprehensive way of dumping a type into a","type":"text"},{"text":" ","type":"text"},{"text":"more structured output. It allows you to construct a custom mirror that describes the structure that","type":"text"},{"text":" ","type":"text"},{"text":"should be dumped. You can omit, add, and replace fields, or even change the “display style” of how","type":"text"},{"text":" ","type":"text"},{"text":"the structure is dumped.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"For example, let’s say you have a struct representing state that holds a secure token in memory that","type":"text"},{"text":" ","type":"text"},{"text":"should never be written to your logs. You can omit the token from ","type":"text"},{"type":"codeVoice","code":"customDump"},{"text":" by providing a mirror","type":"text"},{"text":" ","type":"text"},{"text":"that omits this field:","type":"text"}],"type":"paragraph"},{"code":["struct LoginState: CustomDumpReflectable {","  var username: String","  var token: String","","  var customDumpMirror: Mirror {","    .init(","      self,","      children: [","        \"username\": self.username,","        \/\/ omit token from logs","      ],","      displayStyle: .struct","    )","  }","}","","customDump(","  LoginState(","    username: \"blob\",","    token: \"secret\"","  )",")"],"syntax":"swift","type":"codeListing"},{"code":["LoginState(username: \"blob\")"],"syntax":"text","type":"codeListing"},{"inlineContent":[{"text":"And just like that, no token data will be written to the dump.","type":"text"}],"type":"paragraph"},{"text":"`CustomDumpRepresentable`","anchor":"CustomDumpRepresentable","level":3,"type":"heading"},{"inlineContent":[{"text":"The ","type":"text"},{"type":"codeVoice","code":"CustomDumpRepresentable"},{"text":" protocol allows you to return ","type":"text"},{"type":"emphasis","inlineContent":[{"text":"any","type":"text"}]},{"text":" value for the purpose of dumping.","type":"text"},{"text":" ","type":"text"},{"text":"This can be useful to flatten the dump representation of wrapper types. For example, a type-safe","type":"text"},{"text":" ","type":"text"},{"text":"identifier may want to dump its raw value directly:","type":"text"}],"type":"paragraph"},{"code":["struct ID: RawRepresentable {","  var rawValue: String","}","","extension ID: CustomDumpRepresentable {","  var customDumpValue: Any {","    self.rawValue","  }","}","","customDump(ID(rawValue: \"deadbeef\")"],"syntax":"swift","type":"codeListing"},{"code":["\"deadbeef\""],"syntax":"text","type":"codeListing"}],"kind":"content"}],"references":{"doc://CustomDump/documentation/CustomDump/expectDifference(_:_:operation:changes:fileID:filePath:line:column:)-4f9bh":{"abstract":[{"text":"Expects that a value has a set of changes.","type":"text"}],"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"expectDifference","kind":"identifier"},{"text":"<","kind":"text"},{"text":"T","kind":"genericParameter"},{"text":">(","kind":"text"},{"text":"@autoclosure ","kind":"attribute"},{"text":"() ","kind":"text"},{"text":"throws","kind":"keyword"},{"text":" -> ","kind":"text"},{"text":"T","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"@autoclosure ","kind":"attribute"},{"text":"() -> ","kind":"text"},{"text":"String","kind":"typeIdentifier","preciseIdentifier":"s:SS"},{"text":"?, ","kind":"text"},{"text":"operation","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"nonisolated(nonsending)","kind":"keyword"},{"text":" () ","kind":"text"},{"text":"async","kind":"keyword"},{"text":" ","kind":"text"},{"text":"throws","kind":"keyword"},{"text":" -> ","kind":"text"},{"text":"Void","kind":"typeIdentifier","preciseIdentifier":"s:s4Voida"},{"text":", ","kind":"text"},{"text":"changes","kind":"externalParam"},{"text":": (","kind":"text"},{"text":"inout","kind":"keyword"},{"text":" ","kind":"text"},{"text":"T","kind":"typeIdentifier"},{"text":") ","kind":"text"},{"text":"throws","kind":"keyword"},{"text":" -> ","kind":"text"},{"text":"Void","kind":"typeIdentifier","preciseIdentifier":"s:s4Voida"},{"text":", ","kind":"text"},{"text":"fileID","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"StaticString","kind":"typeIdentifier","preciseIdentifier":"s:s12StaticStringV"},{"text":", ","kind":"text"},{"text":"filePath","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"StaticString","kind":"typeIdentifier","preciseIdentifier":"s:s12StaticStringV"},{"text":", ","kind":"text"},{"text":"line","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"UInt","kind":"typeIdentifier","preciseIdentifier":"s:Su"},{"text":", ","kind":"text"},{"text":"column","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"UInt","kind":"typeIdentifier","preciseIdentifier":"s:Su"},{"text":") ","kind":"text"},{"text":"async","kind":"keyword"}],"role":"symbol","kind":"symbol","type":"topic","url":"\/documentation\/customdump\/expectdifference(_:_:operation:changes:fileid:filepath:line:column:)-4f9bh","identifier":"doc:\/\/CustomDump\/documentation\/CustomDump\/expectDifference(_:_:operation:changes:fileID:filePath:line:column:)-4f9bh","title":"expectDifference(_:_:operation:changes:fileID:filePath:line:column:)"},"doc://CustomDump/documentation/CustomDump/Foundation":{"abstract":[],"role":"collection","kind":"symbol","type":"topic","url":"\/documentation\/customdump\/foundation","identifier":"doc:\/\/CustomDump\/documentation\/CustomDump\/Foundation","title":"Foundation"},"doc://CustomDump/documentation/CustomDump/customDump(_:name:indent:maxDepth:)":{"abstract":[{"text":"Dumps the given value’s contents using its mirror to standard output.","type":"text"}],"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"customDump","kind":"identifier"},{"text":"<","kind":"text"},{"text":"T","kind":"genericParameter"},{"text":">(","kind":"text"},{"text":"T","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"name","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"String","kind":"typeIdentifier","preciseIdentifier":"s:SS"},{"text":"?, ","kind":"text"},{"text":"indent","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:Si","text":"Int","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"maxDepth","kind":"externalParam"},{"text":": ","kind":"text"}
{"metadata":{"modules":[{"name":"CustomDump"}],"roleHeading":"Framework","role":"collection","title":"CustomDump","externalID":"CustomDump","symbolKind":"module"},"schemaVersion":{"major":0,"patch":0,"minor":3},"kind":"symbol","primaryContentSections":[{"content":[{"level":2,"text":"Overview","anchor":"Overview","type":"heading"},{"inlineContent":[{"type":"text","text":"Swift comes with a wonderful tool for dumping the contents of any value to a string, and it’s called"},{"type":"text","text":" "},{"type":"codeVoice","code":"dump"},{"type":"text","text":". It prints all the fields and sub-fields of a value into a tree-like description:"}],"type":"paragraph"},{"code":["struct User {","  var favoriteNumbers: [Int]","  var id: Int","  var name: String","}","","let user = User(","  favoriteNumbers: [42, 1729],","  id: 2,","  name: \"Blob\"",")","","dump(user)"],"syntax":"swift","type":"codeListing"},{"code":["▿ User","  ▿ favoriteNumbers: 2 elements","    - 42","    - 1729","  - id: 2","  - name: \"Blob\""],"syntax":"text","type":"codeListing"},{"inlineContent":[{"type":"text","text":"This is really useful, and can be great for building debug tools that visualize the data held in"},{"type":"text","text":" "},{"type":"text","text":"runtime values of our applications, but sometimes its output is not ideal."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"For example, dumping dictionaries leads to a verbose output that can be hard to read (also note that"},{"type":"text","text":" "},{"type":"text","text":"the keys are unordered):"}],"type":"paragraph"},{"type":"codeListing","code":["dump([1: \"one\", 2: \"two\", 3: \"three\"])"],"syntax":"swift"},{"type":"codeListing","code":["▿ 3 key\/value pairs","  ▿ (2 elements)","    - key: 2","    - value: \"two\"","  ▿ (2 elements)","    - key: 3","    - value: \"three\"","  ▿ (2 elements)","    - key: 1","    - value: \"one\""],"syntax":"text"},{"type":"paragraph","inlineContent":[{"text":"Similarly enums have a very verbose output:","type":"text"}]},{"type":"codeListing","code":["dump(Result<Int, Error>.success(42))"],"syntax":"swift"},{"type":"codeListing","code":["▿ Swift.Result<Swift.Int, Swift.Error>.success","  - success: 42"],"syntax":"text"},{"type":"paragraph","inlineContent":[{"type":"text","text":"It gets even harder to read when dealing with deeply nested structures:"}]},{"type":"codeListing","code":["dump([1: Result<User, Error>.success(user)])"],"syntax":"swift"},{"type":"codeListing","code":["▿ 1 key\/value pair","  ▿ (2 elements)","    - key: 1","    ▿ value: Swift.Result<User, Swift.Error>.success","      ▿ success: User","        ▿ favoriteNumbers: 2 elements","          - 42","          - 1729","        - id: 2","        - name: \"Blob\""],"syntax":"text"},{"type":"paragraph","inlineContent":[{"text":"There are also times that ","type":"text"},{"code":"dump","type":"codeVoice"},{"text":" simply does not print useful information, such as enums imported","type":"text"},{"text":" ","type":"text"},{"text":"from Objective-C:","type":"text"}]},{"type":"codeListing","code":["import UserNotifications","","dump(UNNotificationSetting.disabled)"],"syntax":"swift"},{"type":"codeListing","code":["- __C.UNNotificationSetting"],"syntax":"text"},{"type":"paragraph","inlineContent":[{"type":"text","text":"So, while the "},{"type":"codeVoice","code":"dump"},{"type":"text","text":" function can be handy, it is often too crude of a tool to use. This is the"},{"type":"text","text":" "},{"type":"text","text":"motivation for the "},{"type":"codeVoice","code":"customDump"},{"type":"text","text":" function."}]},{"type":"heading","anchor":"customDump","level":3,"text":"customDump"},{"type":"paragraph","inlineContent":[{"text":"The ","type":"text"},{"type":"reference","identifier":"doc:\/\/CustomDump\/documentation\/CustomDump\/customDump(_:name:indent:maxDepth:)","isActive":true},{"text":" function emulates the behavior of ","type":"text"},{"code":"dump","type":"codeVoice"},{"text":", but provides a","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"more refined output of nested structures, optimizing for readability. For example, structs are"},{"type":"text","text":" "},{"type":"text","text":"dumped in a format that more closely mimics the struct syntax in Swift, and arrays are dumped with"},{"type":"text","text":" "},{"type":"text","text":"the indices of each element:"}]},{"type":"codeListing","code":["import CustomDump","","customDump(user)"],"syntax":"swift"},{"type":"codeListing","code":["User(","  favoriteNumbers: [","    [0]: 42,","    [1]: 1729","  ],","  id: 2,","  name: \"Blob\"",")"],"syntax":"text"},{"type":"paragraph","inlineContent":[{"text":"Dictionaries are dumped in a more compact format that mimics Swift’s syntax, and automatically","type":"text"},{"text":" ","type":"text"},{"text":"orders the keys:","type":"text"}]},{"type":"codeListing","code":["customDump([1: \"one\", 2: \"two\", 3: \"three\"])"],"syntax":"swift"},{"type":"codeListing","code":["[","  1: \"one\",","  2: \"two\",","  3: \"three\"","]"],"syntax":"text"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Similarly, enums also dump in a more compact, readable format:"}]},{"type":"codeListing","code":["customDump(Result<Int, Error>.success(42))"],"syntax":"swift"},{"type":"codeListing","code":["Result.success(42)"],"syntax":"text"},{"type":"paragraph","inlineContent":[{"text":"And deeply nested structures have a simplified tree-structure:","type":"text"}]},{"type":"codeListing","code":["customDump([1: Result<User, Error>.success(user)])"],"syntax":"swift"},{"type":"codeListing","code":["[","  1: Result.success(","    User(","      favoriteNumbers: [","        [0]: 42,","        [1]: 1729","      ],","      id: 2,","      name: \"Blob\"","    )","  )","]"],"syntax":"text"},{"type":"heading","anchor":"diff","level":3,"text":"diff"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Using the output of the "},{"code":"customDump","type":"codeVoice"},{"type":"text","text":" function we can build a very lightweight way to textually diff"},{"type":"text","text":" "},{"type":"text","text":"any two values in Swift using the "},{"isActive":true,"type":"reference","identifier":"doc:\/\/CustomDump\/documentation\/CustomDump\/diff(_:_:format:)"},{"type":"text","text":" function:"}]},{"type":"codeListing","code":["var other = user","other.favoriteNumbers[1] = 91","","print(diff(user, other)!)"],"syntax":"swift"},{"type":"codeListing","code":["  User(","    favoriteNumbers: [","      [0]: 42,","-     [1]: 1729","+     [1]: 91","    ],","    id: 2,","    name: \"Blob\"","  )"],"syntax":"diff"},{"type":"paragraph","inlineContent":[{"text":"Further, extra work is done to minimize the size of the diff when parts of the structure haven’t","type":"text"},{"text":" ","type":"text"},{"text":"changed, such as a single element changing in a large collection:","type":"text"}]},{"type":"codeListing","code":["let users = (1...5).map {","  User(","    favoriteNumbers: [$0],","    id: $0,","    name: \"Blob \\($0)\"","  )","}","","var other = users","other.append(","  .init(","    favoriteNumbers: [42, 1729],","    id: 100,","    name: \"Blob Sr.\"","  )",")","","print(diff(users, other)!)"],"syntax":"swift"},{"type":"codeListing","code":["  [","    … (4 unchanged),","+   [4]: User(","+     favoriteNumbers: [","+       [0]: 42,","+       [1]: 1729","+     ],","+     id: 100,","+     name: \"Blob Sr.\"","+   )","  ]"],"syntax":"diff"},{"inlineContent":[{"type":"text","text":"For a real world use case we modified Apple’s"},{"type":"text","text":" "},{"isActive":true,"type":"reference","identifier":"https:\/\/developer.apple.com\/tutorials\/swiftui\/working-with-ui-controls"},{"type":"text","text":" tutorial"},{"type":"text","text":" "},{"type":"text","text":"application to print the before and after state when favoriting a landmark:"}],"type":"paragraph"},{"syntax":"diff","type":"codeListing","code":["  [","    [0]: Landmark(","      id: 1001,","      name: \"Turtle Rock\",","      park: \"Joshua Tree National Park\",","      state: \"California\",","      description: \"This very large formation lies south of the large Real Hidden Valley parking lot and immediately adjacent to (south of) the picnic areas.\",","-     isFavorite: true,","+     isFavorite: false,","      isFeatured: true,","      category: Category.rivers,","      imageName: \"turtlerock\",","      coordinates: Coordinates(…)","    ),","    … (11 unchanged)","  ]"]},{"level":3,"anchor":"expectNoDifference","type":"heading","text":"expectNoDifference"},{"inlineContent":[{"type":"text","text":"The "},{"type":"codeVoice","code":"XCTAssertEqual"},{"type":"text","text":" function from "},{"type":"codeVoice","code":"XCTest"},{"type":"text","text":" allows you to assert that two values are equal, and if"},{"type":"text","text":" "},{"type":"text","text":"they are not the test suite will fail with a message:"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["var other = user","other.name += \"!\"","","XCTAssertEqual(user, other)"]},{"syntax":"text","type":"codeListing","code":["XCTAssertEqual failed: (\"User(favoriteNumbers: [42, 1729], id: 2, name: \"Blob\")\") is not equal to (\"User(favoriteNumbers: [42, 1729], id: 2, name: \"Blob!\")\")"]},{"inlineContent":[{"type":"text","text":"Unfortunately this failure message is quite difficult to visually parse and understand. It takes a"},{"type":"text","text":" "},{"type":"text","text":"few moments of hunting through the message to see that the only difference is the exclamation mark"},{"type":"text","text":" "},{"type":"text","text":"at the end of the name. The problem gets worse if the type is more complex, consisting of nested"},{"type":"text","text":" "},{"type":"text","text":"structures and large collections."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"This library also ships with an "},{"code":"expectNoDifference(_:_:_:file:line:)","type":"codeVoice"},{"type":"text","text":" function to mitigate"},{"type":"text","text":" "},{"type":"text","text":"these problems. It works like "},{"code":"XCTAssertEqual","type":"codeVoice"},{"type":"text","text":" except the failure message uses a nicely formatted"},{"type":"text","text":" "},{"type":"text","text":"diff to show exactly what is different between the two values:"}],"type":"paragraph"},{"syntax":"swift","code":["expectNoDifference(user, other)"],"type":"codeListing"},{"syntax":"diff","code":["expectNoDifference failed: …","","  User(","    favoriteNumbers: […],","    id: 2,","-   name: \"Blob\"","+   name: \"Blob!\"","  )","","(First: -, Second: +)"],"type":"codeListing"},{"anchor":"expectDifference","type":"heading","text":"expectDifference","level":3},{"inlineContent":[{"code":"expectDifference(_:_:operation:changes:file:line:)-8xfxw","type":"codeVoice"},{"type":"text","text":" provides the inverse of"},{"type":"text","text":" "},{"code":"expectNoDifference","type":"codeVoice"},{"type":"text","text":": it asserts that a value has a set of changes by evaluating a given"},{"type":"text","text":" "},{"type":"text","text":"expression before and after a given operation and then comparing the results."}],"type":"paragraph"},{"inlineContent":[{"text":"For example, given a very simple counter structure, we can write a test against its incrementing","type":"text"},{"text":" ","type":"text"},{"text":"functionality:","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["struct Counter {","  var count = 0","  var isOdd = false","  mutating func increment() {","    self.count += 1","    self.isOdd.toggle()","  }","}","","var counter = Counter()","expectDifference(counter) {","  counter.increment()","} changes: {","  $0.count = 1","  $0.isOdd = true","}"],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"If the "},{"code":"changes","type":"codeVoice"},{"type":"text","text":" does not exhaustively describe all changed fields, the assertion will fail."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"By omitting the operation you can write a “non-exhaustive” assertion against a value by describing"},{"type":"text","text":" "},{"type":"text","text":"just the fields you want to assert against in the "},{"type":"codeVoice","code":"changes"},{"type":"text","text":" closure:"}],"type":"paragraph"},{"syntax":"swift","code":["counter.increment()","expectDifference(counter) {","  $0.count = 1","  \/\/ Don't need to further describe how `isOdd` has changed","}"],"type":"codeListing"},{"anchor":"Customization","type":"heading","text":"Customization","level":2},{"inlineContent":[{"type":"text","text":"Custom Dump provides a few important ways to customize how a data type is dumped:"},{"type":"text","text":" "},{"identifier":"doc:\/\/CustomDump\/documentation\/CustomDump\/CustomDumpStringConvertible","type":"reference","isActive":true},{"type":"text","text":", "},{"isActive":true,"type":"reference","identifier":"doc:\/\/CustomDump\/documentation\/CustomDump\/CustomDumpReflectable"},{"type":"text","text":", and "},{"identifier":"doc:\/\/CustomDump\/documentation\/CustomDump\/CustomDumpRepresentable","isActive":true,"type":"reference"},{"text":".","type":"text"}],"type":"paragraph"},{"level":3,"text":"CustomDumpStringConvertible","type":"heading","anchor":"CustomDumpStringConvertible"},{"inlineContent":[{"text":"The ","type":"text"},{"identifier":"doc:\/\/CustomDump\/documentation\/CustomDump\/CustomDumpStringConvertible","isActive":true,"type":"reference"},{"text":" protocol provides a simple way of converting a type to a raw","type":"text"},{"text":" ","type":"text"},{"text":"string for the purpose of dumping. It is most appropriate for types that have a simple, un-nested","type":"text"},{"text":" ","type":"text"},{"text":"internal representation, and typically its output fits on a single line, for example dates, UUIDs,","type":"text"},{"text":" ","type":"text"},{"text":"URLs, etc:","type":"text"}],"type":"paragraph"},{"code":["extension URL: CustomDumpStringConvertible {","  public var customDumpDescription: String {","    \"URL(\\(self.absoluteString))\"","  }","}","","customDump(URL(string: \"https:\/\/www.pointfree.co\/\")!)"],"type":"codeListing","syntax":"swift"},{"code":["URL(https:\/\/www.pointfree.co\/)"],"type":"codeListing","syntax":"text"},{"inlineContent":[{"type":"text","text":"Custom Dump also uses this protocol internally to provide more useful output for enums imported from"},{"type":"text","text":" "},{"type":"text","text":"Objective-C:"}],"type":"paragraph"},{"code":["import UserNotifications","","print(\"dump:\")","dump(UNNotificationSetting.disabled)","print(\"customDump:\")","customDump(UNNotificationSetting.disabled)"],"type":"codeListing","syntax":"swift"},{"code":["dump:","- __C.UNNotificationSetting","customDump:","UNNotificationSettings.disabled"],"type":"codeListing","syntax":"text"},{"level":3,"text":"CustomDumpReflectable","type":"heading","anchor":"CustomDumpReflectable"},{"inlineContent":[{"type":"text","text":"The "},{"type":"reference","isActive":true,"identifier":"doc:\/\/CustomDump\/documentation\/CustomDump\/CustomDumpReflectable"},{"type":"text","text":" protocol provides a more comprehensive way of dumping a type into a"},{"type":"text","text":" "},{"type":"text","text":"more structured output. It allows you to construct a custom mirror that describes the structure that"},{"type":"text","text":" "},{"type":"text","text":"should be dumped. You can omit, add, and replace fields, or even change the “display style” of how"},{"type":"text","text":" "},{"type":"text","text":"the structure is dumped."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"For example, let’s say you have a struct representing state that holds a secure token in memory that"},{"type":"text","text":" "},{"type":"text","text":"should never be written to your logs. You can omit the token from "},{"code":"customDump","type":"codeVoice"},{"type":"text","text":" by providing a mirror"},{"type":"text","text":" "},{"type":"text","text":"that omits this field:"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["struct LoginState: CustomDumpReflectable {","  var username: String","  var token: String","","  var customDumpMirror: Mirror {","    .init(","      self,","      children: [","        \"username\": self.username,","        \/\/ omit token from logs","      ],","      displayStyle: .struct","    )","  }","}","","customDump(","  LoginState(","    username: \"blob\",","    token: \"secret\"","  )",")"]},{"syntax":"text","type":"codeListing","code":["LoginState(username: \"blob\")"]},{"inlineContent":[{"type":"text","text":"And just like that, no token data will be written to the dump."}],"type":"paragraph"},{"level":3,"text":"`CustomDumpRepresentable`","type":"heading","anchor":"CustomDumpRepresentable"},{"inlineContent":[{"text":"The ","type":"text"},{"code":"CustomDumpRepresentable","type":"codeVoice"},{"text":" protocol allows you to return ","type":"text"},{"type":"emphasis","inlineContent":[{"text":"any","type":"text"}]},{"text":" value for the purpose of dumping.","type":"text"},{"text":" ","type":"text"},{"text":"This can be useful to flatten the dump representation of wrapper types. For example, a type-safe","type":"text"},{"text":" ","type":"text"},{"text":"identifier may want to dump its raw value directly:","type":"text"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["struct ID: RawRepresentable {","  var rawValue: String","}","","extension ID: CustomDumpRepresentable {","  var customDumpValue: Any {","    self.rawValue","  }","}","","customDump(ID(rawValue: \"deadbeef\")"]},{"syntax":"text","type":"codeListing","code":["\"deadbeef\""]}],"kind":"content"}],"variants":[{"paths":["\/documentation\/customdump"],"traits":[{"interfaceLanguage":"swift"}]}],"hierarchy":{"paths":[[]]},"identifier":{"url":"doc:\/\/CustomDump\/documentation\/CustomDump","interfaceLanguage":"swift"},"topicSections":[{"identifiers":["doc:\/\/CustomDump\/documentation\/CustomDump\/customDump(_:name:indent:maxDepth:)","doc:\/\/CustomDump\/documentation\/CustomDump\/customDump(_:to:name:indent:maxDepth:)"],"title":"Dumping","anchor":"Dumping"},{"identifiers":["doc:\/\/CustomDump\/documentation\/CustomDump\/diff(_:_:format:)"],"title":"Diffing","anchor":"Diffing"},{"identifiers":["doc:\/\/CustomDump\/documentation\/CustomDump\/expectNoDifference(_:_:_:fileID:filePath:line:column:)"],"title":"Test support","anchor":"Test-support"},{"identifiers":["doc:\/\/CustomDump\/documentation\/CustomDump\/CustomDumpStringConvertible","doc:\/\/CustomDump\/documentation\/CustomDump\/CustomDumpRepresentable","doc:\/\/CustomDump\/documentation\/CustomDump\/CustomDumpReflectable"],"title":"Customizing output","anchor":"Customizing-output"},{"identifiers":["doc:\/\/CustomDump\/documentation\/CustomDump\/expectDifference(_:_:operation:changes:fileID:filePath:line:column:)-1tzip","doc:\/\/CustomDump\/documentation\/CustomDump\/expectDifference(_:_:operation:changes:fileID:filePath:line:column:)-4f9bh"],"title":"Functions","generated":true,"anchor":"Functions"},{"identifiers":["doc:\/\/CustomDump\/documentation\/CustomDump\/CoreImage","doc:\/\/CustomDump\/documentation\/CustomDump\/CoreLocation","doc:\/\/CustomDump\/documentation\/CustomDump\/CoreMotion","doc:\/\/CustomDump\/documentation\/CustomDump\/Foundation","doc:\/\/CustomDump\/documentation\/CustomDump\/Photos","doc:\/\/CustomDump\/documentation\/CustomDump\/Speech","doc:\/\/CustomDump\/documentation\/CustomDump\/StoreKit","doc:\/\/CustomDump\/documentation\/CustomDump\/Swift","doc:\/\/CustomDump\/documentation\/CustomDump\/SwiftUICore","doc:\/\/CustomDump\/documentation\/CustomDump\/UniformTypeIdentifiers","doc:\/\/CustomDump\/documentation\/CustomDump\/UserNotifications","doc:\/\/CustomDump\/documentation\/CustomDump\/UserNotificationsUI","doc:\/\/CustomDump\/documentation\/CustomDump\/_LocationEssentials"],"title":"Extended Modules","generated":true,"anchor":"Extended-Modules"}],"sections":[],"abstract":[{"type":"text","text":"A collection of tools for debugging, diffing, and testing your application’s data structures."}],"references":{"doc://CustomDump/documentation/CustomDump/CustomDumpRepresentable":{"fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"CustomDumpRepresentable","kind":"identifier"}],"title":"CustomDumpRepresentable","abstract":[{"type":"text","text":"A type that can be converted to a value for the purpose of dumping."}],"url":"\/documentation\/customdump\/customdumprepresentable","navigatorTitle":[{"text":"CustomDumpRepresentable","kind":"identifier"}],"type":"topic","identifier":"doc:\/\/CustomDump\/documentation\/CustomDump\/CustomDumpRepresentable","role":"symbol","kind":"symbol"},"doc://CustomDump/documentation/CustomDump/CoreLocation":{"abstract":[],"role":"collection","identifier":"doc:\/\/CustomDump\/documentation\/CustomDump\/CoreLocation","type":"topic","kind":"symbol","url":"\/documentation\/customdump\/corelocation","title":"CoreLocation"},"doc://CustomDump/documentation/CustomDump/StoreKit":{"kind":"symbol","identifier":"doc:\/\/CustomDump\/documentation\/CustomDump\/StoreKit","type":"topic","url":"\/documentation\/customdump\/storekit","title":"StoreKit","role":"collection","abstract":[]},"https://developer.apple.com/tutorials/swiftui/working-with-ui-controls":{"type":"link","title":"Landmarks","url":"https:\/\/developer.apple.com\/tutorials\/swiftui\/working-with-ui-controls","titleInlineContent":[{"type":"text","text":"Landmarks"}],"identifier":"https:\/\/developer.apple.com\/tutorials\/swiftui\/working-with-ui-controls"},"doc://CustomDump/documentation/CustomDump/CustomDumpReflectable":{"kind":"symbol","identifier":"doc:\/\/CustomDump\/documentation\/CustomDump\/CustomDumpReflectable","type":"topic","url":"\/documentation\/customdump\/customdumpreflectable","title":"CustomDumpReflectable","role":"symbol","abstract":[{"type":"text","text":"A type that explicitly supplies its own mirror for "},{"isActive":true,"type":"reference","identifier":"doc:\/\/CustomDump\/documentation\/CustomDump\/customDump(_:to:name:indent:maxDepth:)"},{"type":"text","text":" "},{"type":"text","text":"and "},{"isActive":true,"type":"reference","identifier":"doc:\/\/CustomDump\/documentation\/CustomDump\/diff(_:_:format:)"},{"type":"text","text":"."}],"fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"CustomDumpReflectable","kind":"identifier"}],"navigatorTitle":[{"text":"CustomDumpReflectable","kind":"identifier"}]},"doc://CustomDump/documentation/CustomDump/Speech":{"kind":"symbol","identifier":"doc:\/\/CustomDump\/documentation\/CustomDump\/Speech","type":"topic","url":"\/documentation\/customdump\/speech","title":"Speech","role":"collection","abstract":[]},"doc://CustomDump/documentation/CustomDump/SwiftUICore":{"url":"\/documentation\/customdump\/swiftuicore","identifier":"doc:\/\/CustomDump\/documentation\/CustomDump\/SwiftUICore","abstract":[],"title":"SwiftUICore","type":"topic","kind":"symbol","role":"collection"},"doc://CustomDump/documentation/CustomDump/diff(_:_:format:)":{"url":"\/documentation\/customdump\/diff(_:_:format:)","identifier":"doc:\/\/CustomDump\/documentation\/CustomDump\/diff(_:_:format:)","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"diff","kind":"identifier"},{"text":"<","kind":"text"},{"text":"T","kind":"genericParameter"},{"text":">(","kind":"text"},{"text":"T","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"T","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"format","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"DiffFormat","kind":"typeIdentifier","preciseIdentifier":"s:10CustomDump10DiffFormatV"},{"text":") -> ","kind":"text"},{"text":"String","kind":"typeIdentifier","preciseIdentifier":"s:SS"},{"text":"?","kind":"text"}],"abstract":[{"type":"text","
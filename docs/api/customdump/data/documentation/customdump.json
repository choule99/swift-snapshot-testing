{"variants":[{"paths":["\/documentation\/customdump"],"traits":[{"interfaceLanguage":"swift"}]}],"schemaVersion":{"major":0,"minor":3,"patch":0},"metadata":{"symbolKind":"module","modules":[{"name":"CustomDump"}],"roleHeading":"Framework","role":"collection","title":"CustomDump","externalID":"CustomDump"},"primaryContentSections":[{"content":[{"level":2,"text":"Overview","type":"heading","anchor":"Overview"},{"inlineContent":[{"type":"text","text":"Swift comes with a wonderful tool for dumping the contents of any value to a string, and it’s called"},{"type":"text","text":" "},{"code":"dump","type":"codeVoice"},{"type":"text","text":". It prints all the fields and sub-fields of a value into a tree-like description:"}],"type":"paragraph"},{"syntax":"swift","code":["struct User {","  var favoriteNumbers: [Int]","  var id: Int","  var name: String","}","","let user = User(","  favoriteNumbers: [42, 1729],","  id: 2,","  name: \"Blob\"",")","","dump(user)"],"type":"codeListing"},{"syntax":"text","code":["▿ User","  ▿ favoriteNumbers: 2 elements","    - 42","    - 1729","  - id: 2","  - name: \"Blob\""],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"This is really useful, and can be great for building debug tools that visualize the data held in"},{"type":"text","text":" "},{"type":"text","text":"runtime values of our applications, but sometimes its output is not ideal."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"For example, dumping dictionaries leads to a verbose output that can be hard to read (also note that"},{"type":"text","text":" "},{"type":"text","text":"the keys are unordered):"}],"type":"paragraph"},{"syntax":"swift","code":["dump([1: \"one\", 2: \"two\", 3: \"three\"])"],"type":"codeListing"},{"syntax":"text","code":["▿ 3 key\/value pairs","  ▿ (2 elements)","    - key: 2","    - value: \"two\"","  ▿ (2 elements)","    - key: 3","    - value: \"three\"","  ▿ (2 elements)","    - key: 1","    - value: \"one\""],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"Similarly enums have a very verbose output:"}],"type":"paragraph"},{"syntax":"swift","code":["dump(Result<Int, Error>.success(42))"],"type":"codeListing"},{"type":"codeListing","syntax":"text","code":["▿ Swift.Result<Swift.Int, Swift.Error>.success","  - success: 42"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"It gets even harder to read when dealing with deeply nested structures:"}]},{"type":"codeListing","syntax":"swift","code":["dump([1: Result<User, Error>.success(user)])"]},{"type":"codeListing","syntax":"text","code":["▿ 1 key\/value pair","  ▿ (2 elements)","    - key: 1","    ▿ value: Swift.Result<User, Swift.Error>.success","      ▿ success: User","        ▿ favoriteNumbers: 2 elements","          - 42","          - 1729","        - id: 2","        - name: \"Blob\""]},{"type":"paragraph","inlineContent":[{"text":"There are also times that ","type":"text"},{"code":"dump","type":"codeVoice"},{"text":" simply does not print useful information, such as enums imported","type":"text"},{"text":" ","type":"text"},{"text":"from Objective-C:","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["import UserNotifications","","dump(UNNotificationSetting.disabled)"]},{"type":"codeListing","syntax":"text","code":["- __C.UNNotificationSetting"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"So, while the "},{"code":"dump","type":"codeVoice"},{"type":"text","text":" function can be handy, it is often too crude of a tool to use. This is the"},{"type":"text","text":" "},{"type":"text","text":"motivation for the "},{"code":"customDump","type":"codeVoice"},{"type":"text","text":" function."}]},{"type":"heading","level":3,"anchor":"customDump","text":"customDump"},{"type":"paragraph","inlineContent":[{"text":"The ","type":"text"},{"type":"reference","identifier":"doc:\/\/CustomDump\/documentation\/CustomDump\/customDump(_:name:indent:maxDepth:)","isActive":true},{"text":" function emulates the behavior of ","type":"text"},{"code":"dump","type":"codeVoice"},{"text":", but provides a","type":"text"},{"text":" ","type":"text"},{"text":"more refined output of nested structures, optimizing for readability. For example, structs are","type":"text"},{"text":" ","type":"text"},{"text":"dumped in a format that more closely mimics the struct syntax in Swift, and arrays are dumped with","type":"text"},{"text":" ","type":"text"},{"text":"the indices of each element:","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["import CustomDump","","customDump(user)"]},{"type":"codeListing","syntax":"text","code":["User(","  favoriteNumbers: [","    [0]: 42,","    [1]: 1729","  ],","  id: 2,","  name: \"Blob\"",")"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Dictionaries are dumped in a more compact format that mimics Swift’s syntax, and automatically"},{"type":"text","text":" "},{"type":"text","text":"orders the keys:"}]},{"code":["customDump([1: \"one\", 2: \"two\", 3: \"three\"])"],"type":"codeListing","syntax":"swift"},{"code":["[","  1: \"one\",","  2: \"two\",","  3: \"three\"","]"],"type":"codeListing","syntax":"text"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Similarly, enums also dump in a more compact, readable format:"}]},{"code":["customDump(Result<Int, Error>.success(42))"],"type":"codeListing","syntax":"swift"},{"code":["Result.success(42)"],"type":"codeListing","syntax":"text"},{"type":"paragraph","inlineContent":[{"type":"text","text":"And deeply nested structures have a simplified tree-structure:"}]},{"code":["customDump([1: Result<User, Error>.success(user)])"],"type":"codeListing","syntax":"swift"},{"code":["[","  1: Result.success(","    User(","      favoriteNumbers: [","        [0]: 42,","        [1]: 1729","      ],","      id: 2,","      name: \"Blob\"","    )","  )","]"],"type":"codeListing","syntax":"text"},{"type":"heading","level":3,"text":"diff","anchor":"diff"},{"type":"paragraph","inlineContent":[{"text":"Using the output of the ","type":"text"},{"code":"customDump","type":"codeVoice"},{"text":" function we can build a very lightweight way to textually diff","type":"text"},{"text":" ","type":"text"},{"text":"any two values in Swift using the ","type":"text"},{"isActive":true,"identifier":"doc:\/\/CustomDump\/documentation\/CustomDump\/diff(_:_:format:)","type":"reference"},{"text":" function:","type":"text"}]},{"code":["var other = user","other.favoriteNumbers[1] = 91","","print(diff(user, other)!)"],"type":"codeListing","syntax":"swift"},{"code":["  User(","    favoriteNumbers: [","      [0]: 42,","-     [1]: 1729","+     [1]: 91","    ],","    id: 2,","    name: \"Blob\"","  )"],"type":"codeListing","syntax":"diff"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Further, extra work is done to minimize the size of the diff when parts of the structure haven’t"},{"type":"text","text":" "},{"type":"text","text":"changed, such as a single element changing in a large collection:"}]},{"code":["let users = (1...5).map {","  User(","    favoriteNumbers: [$0],","    id: $0,","    name: \"Blob \\($0)\"","  )","}","","var other = users","other.append(","  .init(","    favoriteNumbers: [42, 1729],","    id: 100,","    name: \"Blob Sr.\"","  )",")","","print(diff(users, other)!)"],"type":"codeListing","syntax":"swift"},{"code":["  [","    … (4 unchanged),","+   [4]: User(","+     favoriteNumbers: [","+       [0]: 42,","+       [1]: 1729","+     ],","+     id: 100,","+     name: \"Blob Sr.\"","+   )","  ]"],"type":"codeListing","syntax":"diff"},{"type":"paragraph","inlineContent":[{"text":"For a real world use case we modified Apple’s","type":"text"},{"text":" ","type":"text"},{"isActive":true,"type":"reference","identifier":"https:\/\/developer.apple.com\/tutorials\/swiftui\/working-with-ui-controls"},{"type":"text","text":" tutorial"},{"type":"text","text":" "},{"type":"text","text":"application to print the before and after state when favoriting a landmark:"}]},{"syntax":"diff","type":"codeListing","code":["  [","    [0]: Landmark(","      id: 1001,","      name: \"Turtle Rock\",","      park: \"Joshua Tree National Park\",","      state: \"California\",","      description: \"This very large formation lies south of the large Real Hidden Valley parking lot and immediately adjacent to (south of) the picnic areas.\",","-     isFavorite: true,","+     isFavorite: false,","      isFeatured: true,","      category: Category.rivers,","      imageName: \"turtlerock\",","      coordinates: Coordinates(…)","    ),","    … (11 unchanged)","  ]"]},{"type":"heading","level":3,"text":"expectNoDifference","anchor":"expectNoDifference"},{"type":"paragraph","inlineContent":[{"text":"The ","type":"text"},{"code":"XCTAssertEqual","type":"codeVoice"},{"text":" function from ","type":"text"},{"code":"XCTest","type":"codeVoice"},{"text":" allows you to assert that two values are equal, and if","type":"text"},{"text":" ","type":"text"},{"text":"they are not the test suite will fail with a message:","type":"text"}]},{"syntax":"swift","type":"codeListing","code":["var other = user","other.name += \"!\"","","XCTAssertEqual(user, other)"]},{"syntax":"text","type":"codeListing","code":["XCTAssertEqual failed: (\"User(favoriteNumbers: [42, 1729], id: 2, name: \"Blob\")\") is not equal to (\"User(favoriteNumbers: [42, 1729], id: 2, name: \"Blob!\")\")"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Unfortunately this failure message is quite difficult to visually parse and understand. It takes a"},{"type":"text","text":" "},{"type":"text","text":"few moments of hunting through the message to see that the only difference is the exclamation mark"},{"type":"text","text":" "},{"type":"text","text":"at the end of the name. The problem gets worse if the type is more complex, consisting of nested"},{"type":"text","text":" "},{"type":"text","text":"structures and large collections."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"This library also ships with an "},{"code":"expectNoDifference(_:_:_:file:line:)","type":"codeVoice"},{"type":"text","text":" function to mitigate"},{"type":"text","text":" "},{"type":"text","text":"these problems. It works like "},{"code":"XCTAssertEqual","type":"codeVoice"},{"type":"text","text":" except the failure message uses a nicely formatted"},{"type":"text","text":" "},{"type":"text","text":"diff to show exactly what is different between the two values:"}]},{"syntax":"swift","type":"codeListing","code":["expectNoDifference(user, other)"]},{"syntax":"diff","type":"codeListing","code":["expectNoDifference failed: …","","  User(","    favoriteNumbers: […],","    id: 2,","-   name: \"Blob\"","+   name: \"Blob!\"","  )","","(First: -, Second: +)"]},{"level":3,"text":"expectDifference","anchor":"expectDifference","type":"heading"},{"type":"paragraph","inlineContent":[{"code":"expectDifference(_:_:operation:changes:file:line:)-8xfxw","type":"codeVoice"},{"type":"text","text":" provides the inverse of"},{"type":"text","text":" "},{"code":"expectNoDifference","type":"codeVoice"},{"type":"text","text":": it asserts that a value has a set of changes by evaluating a given"},{"type":"text","text":" "},{"type":"text","text":"expression before and after a given operation and then comparing the results."}]},{"type":"paragraph","inlineContent":[{"text":"For example, given a very simple counter structure, we can write a test against its incrementing","type":"text"},{"text":" ","type":"text"},{"text":"functionality:","type":"text"}]},{"code":["struct Counter {","  var count = 0","  var isOdd = false","  mutating func increment() {","    self.count += 1","    self.isOdd.toggle()","  }","}","","var counter = Counter()","expectDifference(counter) {","  counter.increment()","} changes: {","  $0.count = 1","  $0.isOdd = true","}"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"If the ","type":"text"},{"type":"codeVoice","code":"changes"},{"text":" does not exhaustively describe all changed fields, the assertion will fail.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"By omitting the operation you can write a “non-exhaustive” assertion against a value by describing"},{"type":"text","text":" "},{"type":"text","text":"just the fields you want to assert against in the "},{"type":"codeVoice","code":"changes"},{"type":"text","text":" closure:"}]},{"code":["counter.increment()","expectDifference(counter) {","  $0.count = 1","  \/\/ Don't need to further describe how `isOdd` has changed","}"],"type":"codeListing","syntax":"swift"},{"level":2,"text":"Customization","anchor":"Customization","type":"heading"},{"type":"paragraph","inlineContent":[{"text":"Custom Dump provides a few important ways to customize how a data type is dumped:","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/CustomDump\/documentation\/CustomDump\/CustomDumpStringConvertible","isActive":true,"type":"reference"},{"text":", ","type":"text"},{"identifier":"doc:\/\/CustomDump\/documentation\/CustomDump\/CustomDumpReflectable","isActive":true,"type":"reference"},{"text":", and ","type":"text"},{"identifier":"doc:\/\/CustomDump\/documentation\/CustomDump\/CustomDumpRepresentable","isActive":true,"type":"reference"},{"text":".","type":"text"}]},{"level":3,"text":"CustomDumpStringConvertible","anchor":"CustomDumpStringConvertible","type":"heading"},{"inlineContent":[{"type":"text","text":"The "},{"identifier":"doc:\/\/CustomDump\/documentation\/CustomDump\/CustomDumpStringConvertible","type":"reference","isActive":true},{"type":"text","text":" protocol provides a simple way of converting a type to a raw"},{"type":"text","text":" "},{"type":"text","text":"string for the purpose of dumping. It is most appropriate for types that have a simple, un-nested"},{"type":"text","text":" "},{"type":"text","text":"internal representation, and typically its output fits on a single line, for example dates, UUIDs,"},{"type":"text","text":" "},{"type":"text","text":"URLs, etc:"}],"type":"paragraph"},{"code":["extension URL: CustomDumpStringConvertible {","  public var customDumpDescription: String {","    \"URL(\\(self.absoluteString))\"","  }","}","","customDump(URL(string: \"https:\/\/www.pointfree.co\/\")!)"],"syntax":"swift","type":"codeListing"},{"code":["URL(https:\/\/www.pointfree.co\/)"],"syntax":"text","type":"codeListing"},{"inlineContent":[{"type":"text","text":"Custom Dump also uses this protocol internally to provide more useful output for enums imported from"},{"type":"text","text":" "},{"type":"text","text":"Objective-C:"}],"type":"paragraph"},{"code":["import UserNotifications","","print(\"dump:\")","dump(UNNotificationSetting.disabled)","print(\"customDump:\")","customDump(UNNotificationSetting.disabled)"],"syntax":"swift","type":"codeListing"},{"code":["dump:","- __C.UNNotificationSetting","customDump:","UNNotificationSettings.disabled"],"syntax":"text","type":"codeListing"},{"level":3,"text":"CustomDumpReflectable","anchor":"CustomDumpReflectable","type":"heading"},{"inlineContent":[{"type":"text","text":"The "},{"identifier":"doc:\/\/CustomDump\/documentation\/CustomDump\/CustomDumpReflectable","type":"reference","isActive":true},{"type":"text","text":" protocol provides a more comprehensive way of dumping a type into a"},{"type":"text","text":" "},{"type":"text","text":"more structured output. It allows you to construct a custom mirror that describes the structure that"},{"type":"text","text":" "},{"type":"text","text":"should be dumped. You can omit, add, and replace fields, or even change the “display style” of how"},{"type":"text","text":" "},{"type":"text","text":"the structure is dumped."}],"type":"paragraph"},{"inlineContent":[{"text":"For example, let’s say you have a struct representing state that holds a secure token in memory that","type":"text"},{"text":" ","type":"text"},{"text":"should never be written to your logs. You can omit the token from ","type":"text"},{"code":"customDump","type":"codeVoice"},{"text":" by providing a mirror","type":"text"},{"type":"text","text":" "},{"type":"text","text":"that omits this field:"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["struct LoginState: CustomDumpReflectable {","  var username: String","  var token: String","","  var customDumpMirror: Mirror {","    .init(","      self,","      children: [","        \"username\": self.username,","        \/\/ omit token from logs","      ],","      displayStyle: .struct","    )","  }","}","","customDump(","  LoginState(","    username: \"blob\",","    token: \"secret\"","  )",")"]},{"type":"codeListing","syntax":"text","code":["LoginState(username: \"blob\")"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"And just like that, no token data will be written to the dump."}]},{"anchor":"CustomDumpRepresentable","type":"heading","level":3,"text":"`CustomDumpRepresentable`"},{"type":"paragraph","inlineContent":[{"text":"The ","type":"text"},{"code":"CustomDumpRepresentable","type":"codeVoice"},{"text":" protocol allows you to return ","type":"text"},{"inlineContent":[{"text":"any","type":"text"}],"type":"emphasis"},{"text":" value for the purpose of dumping.","type":"text"},{"text":" ","type":"text"},{"text":"This can be useful to flatten the dump representation of wrapper types. For example, a type-safe","type":"text"},{"text":" ","type":"text"},{"text":"identifier may want to dump its raw value directly:","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["struct ID: RawRepresentable {","  var rawValue: String","}","","extension ID: CustomDumpRepresentable {","  var customDumpValue: Any {","    self.rawValue","  }","}","","customDump(ID(rawValue: \"deadbeef\")"]},{"type":"codeListing","syntax":"text","code":["\"deadbeef\""]}],"kind":"content"}],"kind":"symbol","identifier":{"url":"doc:\/\/CustomDump\/documentation\/CustomDump","interfaceLanguage":"swift"},"topicSections":[{"identifiers":["doc:\/\/CustomDump\/documentation\/CustomDump\/customDump(_:name:indent:maxDepth:)","doc:\/\/CustomDump\/documentation\/CustomDump\/customDump(_:to:name:indent:maxDepth:)"],"anchor":"Dumping","title":"Dumping"},{"identifiers":["doc:\/\/CustomDump\/documentation\/CustomDump\/diff(_:_:format:)"],"anchor":"Diffing","title":"Diffing"},{"identifiers":["doc:\/\/CustomDump\/documentation\/CustomDump\/expectNoDifference(_:_:_:fileID:filePath:line:column:)"],"anchor":"Test-support","title":"Test support"},{"identifiers":["doc:\/\/CustomDump\/documentation\/CustomDump\/CustomDumpStringConvertible","doc:\/\/CustomDump\/documentation\/CustomDump\/CustomDumpRepresentable","doc:\/\/CustomDump\/documentation\/CustomDump\/CustomDumpReflectable"],"anchor":"Customizing-output","title":"Customizing output"},{"identifiers":["doc:\/\/CustomDump\/documentation\/CustomDump\/expectDifference(_:_:operation:changes:fileID:filePath:line:column:)-1tzip","doc:\/\/CustomDump\/documentation\/CustomDump\/expectDifference(_:_:operation:changes:fileID:filePath:line:column:)-4f9bh"],"generated":true,"anchor":"Functions","title":"Functions"},{"identifiers":["doc:\/\/CustomDump\/documentation\/CustomDump\/CoreImage","doc:\/\/CustomDump\/documentation\/CustomDump\/CoreLocation","doc:\/\/CustomDump\/documentation\/CustomDump\/CoreMotion","doc:\/\/CustomDump\/documentation\/CustomDump\/Foundation","doc:\/\/CustomDump\/documentation\/CustomDump\/Photos","doc:\/\/CustomDump\/documentation\/CustomDump\/Speech","doc:\/\/CustomDump\/documentation\/CustomDump\/StoreKit","doc:\/\/CustomDump\/documentation\/CustomDump\/Swift","doc:\/\/CustomDump\/documentation\/CustomDump\/SwiftUICore","doc:\/\/CustomDump\/documentation\/CustomDump\/UniformTypeIdentifiers","doc:\/\/CustomDump\/documentation\/CustomDump\/UserNotifications","doc:\/\/CustomDump\/documentation\/CustomDump\/UserNotificationsUI","doc:\/\/CustomDump\/documentation\/CustomDump\/_LocationEssentials"],"generated":true,"anchor":"Extended-Modules","title":"Extended Modules"}],"hierarchy":{"paths":[[]]},"sections":[],"abstract":[{"type":"text","text":"A collection of tools for debugging, diffing, and testing your application’s data structures."}],"references":{"doc://CustomDump/documentation/CustomDump/Photos":{"identifier":"doc:\/\/CustomDump\/documentation\/CustomDump\/Photos","role":"collection","title":"Photos","abstract":[],"url":"\/documentation\/customdump\/photos","kind":"symbol","type":"topic"},"doc://CustomDump/documentation/CustomDump/expectDifference(_:_:operation:changes:fileID:filePath:line:column:)-4f9bh":{"fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"expectDifference"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"T"},{"kind":"text","text":">("},{"kind":"attribute","text":"@autoclosure "},{"kind":"text","text":"() "},{"kind":"keyword","text":"throws"},{"kind":"text","text":" -> "},{"kind":"typeIdentifier","text":"T"},{"kind":"text","text":", "},{"kind":"attribute","text":"@autoclosure "},{"kind":"text","text":"() -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:SS","text":"String"},{"kind":"text","text":"?, "},{"kind":"externalParam","text":"operation"},{"kind":"text","text":": "},{"kind":"keyword","text":"nonisolated(nonsending)"},{"kind":"text","text":" () "},{"kind":"keyword","text":"async"},{"kind":"text","text":" "},{"kind":"keyword","text":"throws"},{"kind":"text","text":" -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:s4Voida","text":"Void"},{"kind":"text","text":", "},{"kind":"externalParam","text":"changes"},{"kind":"text","text":": ("},{"kind":"keyword","text":"inout"},{"kind":"text","text":" "},{"kind":"typeIdentifier","text":"T"},{"kind":"text","text":") "},{"kind":"keyword","text":"throws"},{"text":" -> ","kind":"text"},{"preciseIdentifier":"s:s4Voida","text":"Void","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"fileID","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"StaticString","kind":"typeIdentifier","preciseIdentifier":"s:s12StaticStringV"},{"text":", ","kind":"text"},{"text":"filePath","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"StaticString","kind":"typeIdentifier","preciseIdentifier":"s:s12StaticStringV"},{"text":", ","kind":"text"},{"text":"line","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"UInt","kind":"typeIdentifier","preciseIdentifier":"s:Su"},{"text":", ","kind":"text"},{"text":"column","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"UInt","kind":"typeIdentifier","preciseIdentifier":"s:Su"},{"text":") ","kind":"text"},{"text":"async","kind":"keyword"}],"abstract":[{"type":"text","text":"Expects that a value has a set of changes."}],"type":"topic","kind":"symbol","url":"\/documentation\/customdump\/expectdifference(_:_:operation:changes:fileid:filepath:line:column:)-4f9bh","role":"symbol","title":"expectDifference(_:_:operation:changes:fileID:filePath:line:column:)","identifier":"doc:\/\/CustomDump\/documentation\/CustomDump\/expectDifference(_:_:operation:changes:fileID:filePath:line:column:)-4f9bh"},"doc://CustomDump/documentation/CustomDump/Swift":{"url":"\/documentation\/customdump\/swift","type":"topic","abstract":[],"identifier":"doc:\/\/CustomDump\/documentation\/CustomDump\/Swift","title":"Swift","role":"collection","kind":"symbol"},"doc://CustomDump/documentation/CustomDump/Speech":{"identifier":"doc:\/\/CustomDump\/documentation\/CustomDump\/Speech","kind":"symbol","type":"topic","url":"\/documentation\/customdump\/speech","role":"collection","title":"Speech","abstract":[]},"doc://CustomDump/documentation/CustomDump/_LocationEssentials":{"url":"\/documentation\/customdump\/_locationessentials","type":"topic","abstract":[],"identifier":"doc:\/\/CustomDump\/documentation\/CustomDump\/_LocationEssentials","title":"_LocationEssentials","role":"collection","kind":"symbol"},"doc://CustomDump/documentation/CustomDump/customDump(_:name:indent:maxDepth:)":{"fra
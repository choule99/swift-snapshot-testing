t"}],"type":"paragraph"}],"name":"message"},{"content":[{"inlineContent":[{"text":"An optional operation that is performed in between an initial and final","type":"text"},{"text":" ","type":"text"},{"text":"evaluation of ","type":"text"},{"code":"operation","type":"codeVoice"},{"text":". By omitting this operation, you can write a “non-exhaustive”","type":"text"},{"text":" ","type":"text"},{"text":"assertion against an already-changed value by describing just the fields you want to assert","type":"text"},{"text":" ","type":"text"},{"text":"against in the ","type":"text"},{"code":"changes","type":"codeVoice"},{"text":" closure.","type":"text"}],"type":"paragraph"}],"name":"operation"},{"content":[{"inlineContent":[{"text":"A closure that asserts how the expression changed by supplying a","type":"text"},{"text":" ","type":"text"},{"text":"mutable version of the initial value. This value must be modified to match the final value.","type":"text"}],"type":"paragraph"}],"name":"updateExpectingResult"}]},{"content":[{"text":"Discussion","type":"heading","anchor":"discussion","level":2},{"type":"paragraph","inlineContent":[{"text":"This function evaluates a given expression before and after a given operation and then compares","type":"text"},{"text":" ","type":"text"},{"text":"the results. The comparison is done by invoking the ","type":"text"},{"code":"changes","type":"codeVoice"},{"text":" closure with a mutable version of","type":"text"},{"text":" ","type":"text"},{"text":"the initial value, and then asserting that the modifications made match the final value using","type":"text"},{"text":" ","type":"text"},{"code":"expectNoDifference","type":"codeVoice"},{"text":".","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"For example, given a very simple counter structure, we can write a test against its incrementing","type":"text"},{"text":" ","type":"text"},{"text":"functionality:","type":"text"},{"text":" ","type":"text"},{"text":"`","type":"text"}]},{"syntax":
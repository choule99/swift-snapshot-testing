"keyword"},{"text":" ","kind":"text"},{"text":"T","kind":"typeIdentifier"},{"text":") ","kind":"text"},{"text":"throws","kind":"keyword"},{"text":" -> ","kind":"text"},{"preciseIdentifier":"s:s4Voida","text":"Void","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"fileID","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:s12StaticStringV","text":"StaticString","kind":"typeIdentifier"},{"text":" = ","kind":"text"},{"kind":"keyword","text":"#fileID"},{"kind":"text","text":", "},{"kind":"externalParam","text":"filePath"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:s12StaticStringV","text":"StaticString"},{"kind":"text","text":" = "},{"kind":"keyword","text":"#filePath"},{"kind":"text","text":", "},{"kind":"externalParam","text":"line"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:Su","text":"UInt"},{"kind":"text","text":" = "},{"kind":"keyword","text":"#line"},{"kind":"text","text":", "},{"kind":"externalParam","text":"column"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:Su","text":"UInt"},{"kind":"text","text":" = "},{"kind":"keyword","text":"#column"},{"kind":"text","text":") "},{"kind":"keyword","text":"where"},{"kind":"text","text":" "},{"kind":"typeIdentifier","text":"T"},{"kind":"text","text":" : "},{"kind":"typeIdentifier","preciseIdentifier":"s:SQ","text":"Equatable"}],"platforms":["macOS"]}]},{"parameters":[{"content":[{"inlineContent":[{"text":"An expression that is evaluated before and after ","type":"text"},{"code":"operation","type":"codeVoice"},{"text":", and then compared.","type":"text"}],"type":"paragraph"}],"name":"expression"},{"name":"message","content":[{"inlineContent":[{"type":"text","text":"An optional description of a failure."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"An optional operation that is performed in between an initial and final","type":"text"},{"text":" ","type":"text"},{"text":"evaluation of ","type":"text"},{"type":"codeVoice","code":"operation"},{"text":". By omitting this operation, you can write a “non-exhaustive”","type":"text"},{"text":" ","type":"text"},{"text":"assertion against an already-changed value by describing just the fields you want to assert","type":"text"},{"text":" ","type":"text"},{"text":"against in the ","type":"text"},{"type":"codeVoice","code":"changes"},{"text":" closure.","type":"text"}],"type":"paragraph"}],"name":"operation"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"A closure that asserts how the expression changed by supplying a"},{"type":"text","text":" "},{"type":"text","text":"mutable version of the initial value. This value must be modified to match the final value."}]}],"name":"updateExpectingResult"}],"kind":"parameters"},{"content":[{"anchor":"discussion","level":2,"text":"Discussion","type":"heading"},{"inlineContent":[{"text":"This function evaluates a given expression before and after a given operation and then compares","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"the results. The comparison is done by invoking the "},{"code":"changes","type":"codeVoice"},{"text":" closure with a mutable version of","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"the initial value, and then asserting that the modifications made match the final value using"},{"text":" ","type":"text"},{"type":"codeVoice","code":"expectNoDifference"},{"text":".","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"For example, given a very simple counter structure, we can write a test against its incrementing","type":"text"},{"type":"text","text":" "},{"type":"text","text":"functionality:"},{"type":"text","text":" "},{"type":"text","text":"`"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["struct Counter {","  var count = 0","  var isOdd = false","  mutating func increment() {","    self.count += 1","    self.isOdd.toggle()","  }","}","","var counter = Counter()","expectDifference(counter) {","  counter.increment()","} changes: {","  $0.count = 1","  $0.isOdd = true","}"]},{"inlineContent":[{"text":"If the ","type":"text"},{"code":"changes","type":"codeVoice"},{"text":" does not exhaustively describe all changed fields, the assertion will fail.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"To write a “non-exhaustive” assertion against a value, perform the mutating work up front, and"},{"type":"text","text":" "},{"type":"text","text":"describe just the fields you want to assert against in the "},{"code":"changes","type":"codeVoice"},{"type":"text","text":" closure:"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["counter.increment()","expectDifference(counter) {","  $0.count = 1","  \/\/ Don't need to further describe how `isOdd` has changed","}"]}],"kind":"content"}],"identifier":{"url":"doc:\/\/CustomDump\/documentation\/CustomDump\/expectDifference(_:_:operation:changes:fileID:filePath:line:column:)-1tzip","interfaceLanguage":"swift"},"kind":"symbol","references":{"doc://CustomDump/documentation/CustomDump/expectDifference(_:_:operation:changes:fileID:filePath:line:column:)-1tzip":{"kind":"symbol","identifier":"doc:\/\/CustomDump\/documentation\/CustomDump\/expectDifference(_:_:operation:changes:fileID:filePath:line:column:)-1tzip","type":"topic","url":"\/documentation\/customdump\/expectdifference(_:_:operation:changes:fileid:filepath:line:column:)-1tzip","title":"expectDifference(_:_:operation:changes:fileID:filePath:line:column:)","role":"symbol","abstract":[{"type":"text","text":"Expects that a value has a set of changes."}],"fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"expectDifference"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"T"},{"kind":"text","text":">("},{"kind":"attribute","text":"@autoclosure "},{"kind":"text","text":"() "},{"kind":"keyword","text":"throws"
{"relationshipsSections":[{"kind":"relationships","title":"Conforming Types","type":"conformingTypes","identifiers":["doc:\/\/CustomDump\/documentation\/CustomDump\/_LocationEssentials\/CLFloor","doc:\/\/CustomDump\/documentation\/CustomDump\/_LocationEssentials\/CLLocation","doc:\/\/CustomDump\/documentation\/CustomDump\/_LocationEssentials\/CLLocationSourceInformation","doc:\/\/CustomDump\/documentation\/CustomDump\/Foundation\/Calendar","doc:\/\/CustomDump\/documentation\/CustomDump\/Foundation\/NSError","doc:\/\/CustomDump\/documentation\/CustomDump\/Foundation\/NSException","doc:\/\/CustomDump\/documentation\/CustomDump\/Foundation\/NSOrderedSet","doc:\/\/CustomDump\/documentation\/CustomDump\/Foundation\/TimeZone","doc:\/\/CustomDump\/documentation\/CustomDump\/UserNotifications\/UNAuthorizationOptions","doc:\/\/CustomDump\/documentation\/CustomDump\/UserNotifications\/UNNotificationPresentationOptions"]}],"schemaVersion":{"patch":0,"minor":3,"major":0},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/customdump\/customdumpreflectable"]}],"seeAlsoSections":[{"title":"Customizing output","anchor":"Customizing-output","identifiers":["doc:\/\/CustomDump\/documentation\/CustomDump\/CustomDumpStringConvertible","doc:\/\/CustomDump\/documentation\/CustomDump\/CustomDumpRepresentable"],"generated":true}],"metadata":{"externalID":"s:10CustomDump0aB11ReflectableP","modules":[{"name":"CustomDump"}],"role":"symbol","navigatorTitle":[{"kind":"identifier","text":"CustomDumpReflectable"}],"title":"CustomDumpReflectable","symbolKind":"protocol","fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"CustomDumpReflectable","kind":"identifier"}],"roleHeading":"Protocol"},"topicSections":[{"title":"Instance Properties","anchor":"Instance-Properties","identifiers":["doc:\/\/CustomDump\/documentation\/CustomDump\/CustomDumpReflectable\/customDumpMirror"],"generated":true}],"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"CustomDumpReflectable","kind":"identifier"}],"languages":["swift"],"platforms":["macOS"]}]},{"kind":"content","content":[{"anchor":"overview","level":2,"text":"Overview","type":"heading"},{"inlineContent":[{"text":"Types that want to customize their dump output can conform to this protocol, especially those","type":"text"},{"text":" ","type":"text"},{"text":"with a complex or nested internal structure. Providing a custom mirror allows you to reorder,","type":"text"},{"text":" ","type":"text"},{"text":"transform, or omit fields on a base structure, or even change the representation of the base","type":"text"},{"text":" ","type":"text"},{"text":"structure itself.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"For unstructured data types, or data types that are represented by single values, see the","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/CustomDump\/documentation\/CustomDump\/CustomDumpStringConvertible","type":"reference","isActive":true},{"text":" protocol.","type":"text"}],"type":"paragraph"},{"anchor":"Customizing-the-dump-of-a-structures-fields","level":2,"text":"Customizing the dump of a structure’s fields","type":"heading"},{"inlineContent":[{"text":"For example, let’s say you have a struct representing login state, which holds a secure token in","type":"text"},{"text":" ","type":"text"},{"text":"memory that should never be written to your logs. You can omit the token from ","type":"text"},{"code":"customDump","type":"codeVoice"},{"text":" by","type":"text"},{"text":" ","type":"text"},{"text":"providing a mirror that omits this field:","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["struct LoginState: CustomDumpReflectable {","  var email = \"\"","  var password = \"\"","  var token: String","","  var customDumpMirror: Mirror {","    .init(","      self,","      children: [","        \"email\": self.email,","        \"password\": self.password","        \/\/ omit token from logs","      ],","      displayStyle: .struct","    )","  }","}","","customDump(","  LoginState(","    email: \"blob@pointfree.co\",","    password: \"bl0bisawesome!\",","    token: \"secret\"","  )",")"],"type":"codeListing"},{"syntax":"text","code":["LoginState(","  email: \"blob@pointfree.co\",","  password: \"bl0bisawesome!\"",")"],"type":"codeListing"},{"inlineContent":[{"text":"There! No token data is being written to the dump. However, the dump still contains the user’s","type":"text"},{"text":" ","type":"text"},{"text":"password, which is sensitive. Rather than omit it entirely, we could redact this information","type":"text"},{"text":" ","type":"text"},{"text":"using a ","type":"text"},{"code":"Redacted","type":"codeVoice"},{"text":" wrapper type that redacts its contents from custom dumps via the","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/CustomDump\/documentation\/CustomDump\/CustomDumpStringConvertible","type":"reference","isActive":true},{"text":" protocol:","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["struct Redacted<RawValue>: CustomDumpStringConvertible {","  let rawValue: RawValue","","  var customDumpDescription: String {","    \"<redacted>\"","  }","}","","struct LoginState: CustomDumpReflectable {","  ...","  var customDumpMirror: Mirror {","    .init(","      self,","      children: [","        \"email\": self.email,","        \/\/ redact password!","        \"password\": Redacted(rawValue: self.password)","        \/\/ omit token from logs","      ],","      displayStyle: .struct","    )","  }","}","","customDump(","  LoginState(","    email: \"blob@pointfree.co\",","    password: \"bl0bisawesome!\",","    token: \"secret\"","  )",")"],"type":"codeListing"},{"syntax":"text","code":["LoginState(","  email: \"blob@pointfree.co\",","  password: <redacted>",")"],"type":"codeListing"},{"inlineContent":[{"text":"Now the dump retains the fact that a password field exists, but it prevents the underlying value","type":"text"},{"text":" ","type":"text"},{"text":"from being logged.","type":"text"}],"type":"paragraph"},{"anchor":"Overriding-a-structures-dump-representation","level":2,"text":"Overriding a structure’s dump representation","type":"heading"},{"inlineContent":[{"text":"Massaging the data inside a structure is just one way to use a custom mirror. A mirror can also","type":"text"},{"text":" ","type":"text"},{"text":"let you completely transform the ","type":"text"},{"inlineContent":[{"text":"way","type":"text"}],"type":"emphasis"},{"text":" a structure is dumped.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"For example, a wrapper type can be flattened to dump the wrapped value by providing the wrapped","type":"text"},{"text":" ","type":"text"},{"text":"value’s mirror:","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["struct Todos: CustomDumpReflectable {","  var rawValue: [Todo] = []","","  var customDumpMirror: Mirror {","    .init(reflecting: self.rawValue)","  }","}","","customDump(Todos())"],"type":"codeListing"},{"syntax":"text","code":["[]"],"type":"codeListing"}]}],"abstract":[{"text":"A type that explicitly supplies its own mirror for ","type":"text"},{"identifier":"doc:\/\/CustomDump\/documentation\/CustomDump\/customDump(_:to:name:indent:maxDepth:)","isActive":true,"type":"reference"},{"text":" ","type":"text"},{"text":"and ","type":"text"},{"identifier":"doc:\/\/CustomDump\/documentation\/CustomDump\/diff(_:_:format:)","isActive":true,"type":"reference"},{"text":".","type":"text"}],"kind":"symbol","identifier":{"url":"doc:\/\/CustomDump\/documentation\/CustomDump\/CustomDumpReflectable","interfaceLanguage":"swift"},"sections":[],"hierarchy":{"paths":[["doc:\/\/CustomDump\/documentation\/CustomDump"]]},"references":{"doc://CustomDump/documentation/CustomDump/_LocationEssentials/CLLocationSourceInformation":{"abstract":[],"fragments":[{"text":"extension",
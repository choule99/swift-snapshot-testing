{"relationshipsSections":[{"identifiers":["doc:\/\/CustomDump\/documentation\/CustomDump\/_LocationEssentials\/CLFloor","doc:\/\/CustomDump\/documentation\/CustomDump\/_LocationEssentials\/CLLocation","doc:\/\/CustomDump\/documentation\/CustomDump\/_LocationEssentials\/CLLocationSourceInformation","doc:\/\/CustomDump\/documentation\/CustomDump\/Foundation\/Calendar","doc:\/\/CustomDump\/documentation\/CustomDump\/Foundation\/NSError","doc:\/\/CustomDump\/documentation\/CustomDump\/Foundation\/NSException","doc:\/\/CustomDump\/documentation\/CustomDump\/Foundation\/NSOrderedSet","doc:\/\/CustomDump\/documentation\/CustomDump\/Foundation\/TimeZone","doc:\/\/CustomDump\/documentation\/CustomDump\/UserNotifications\/UNAuthorizationOptions","doc:\/\/CustomDump\/documentation\/CustomDump\/UserNotifications\/UNNotificationPresentationOptions"],"kind":"relationships","title":"Conforming Types","type":"conformingTypes"}],"schemaVersion":{"patch":0,"minor":3,"major":0},"seeAlsoSections":[{"generated":true,"anchor":"Customizing-output","title":"Customizing output","identifiers":["doc:\/\/CustomDump\/documentation\/CustomDump\/CustomDumpStringConvertible","doc:\/\/CustomDump\/documentation\/CustomDump\/CustomDumpRepresentable"]}],"variants":[{"paths":["\/documentation\/customdump\/customdumpreflectable"],"traits":[{"interfaceLanguage":"swift"}]}],"primaryContentSections":[{"declarations":[{"tokens":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"CustomDumpReflectable","kind":"identifier"}],"languages":["swift"],"platforms":["macOS"]}],"kind":"declarations"},{"content":[{"text":"Overview","type":"heading","level":2,"anchor":"overview"},{"inlineContent":[{"text":"Types that want to customize their dump output can conform to this protocol, especially those","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"with a complex or nested internal structure. Providing a custom mirror allows you to reorder,"},{"type":"text","text":" "},{"type":"text","text":"transform, or omit fields on a base structure, or even change the representation of the base"},{"type":"text","text":" "},{"type":"text","text":"structure itself."}],"type":"paragraph"},{"inlineContent":[{"text":"For unstructured data types, or data types that are represented by single values, see the","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/CustomDump\/documentation\/CustomDump\/CustomDumpStringConvertible","type":"reference","isActive":true},{"text":" protocol.","type":"text"}],"type":"paragraph"},{"level":2,"anchor":"Customizing-the-dump-of-a-structures-fields","type":"heading","text":"Customizing the dump of a structure’s fields"},{"inlineContent":[{"type":"text","text":"For example, let’s say you have a struct representing login state, which holds a secure token in"},{"type":"text","text":" "},{"type":"text","text":"memory that should never be written to your logs. You can omit the token from "},{"code":"customDump","type":"codeVoice"},{"type":"text","text":" by"},{"type":"text","text":" "},{"type":"text","text":"providing a mirror that omits this field:"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["struct LoginState: CustomDumpReflectable {","  var email = \"\"","  var password = \"\"","  var token: String","","  var customDumpMirror: Mirror {","    .init(","      self,","      children: [","        \"email\": self.email,","        \"password\": self.password","        \/\/ omit token from logs","      ],","      displayStyle: .struct","    )","  }","}","","customDump(","  LoginState(","    email: \"blob@pointfree.co\",","    password: \"bl0bisawesome!\",","    token: \"secret\"","  )",")"]},{"syntax":"text","type":"codeListing","code":["LoginState(","  email: \"blob@pointfree.co\",","  password: \"bl0bisawesome!\"",")"]},{"inlineContent":[{"text":"There! No token data is being written to the dump. However, the dump still contains the user’s","type":"text"},{"text":" ","type":"text"},{"text":"password, which is sensitive. Rather than omit it entirely, we could redact this information","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"using a "},{"type":"codeVoice","code":"Redacted"},{"type":"text","text":" wrapper type that redacts its contents from custom dumps via the"},{"type":"text","text":" "},{"isActive":true,"type":"reference","identifier":"doc:\/\/CustomDump\/documentation\/CustomDump\/CustomDumpStringConvertible"},{"type":"text","text":" protocol:"}],"type":"paragraph"},{"code":["struct Redacted<RawValue>: CustomDumpStringConvertible {","  let rawValue: RawValue","","  var customDumpDescription: String {","    \"<redacted>\"","  }","}","","struct LoginState: CustomDumpReflectable {","  ...","  var customDumpMirror: Mirror {","    .init(","      self,","      children: [","        \"email\": self.email,","        \/\/ redact password!","        \"password\": Redacted(rawValue: self.password)","        \/\/ omit token from logs","      ],","      displayStyle: .struct","    )","  }","}","","customDump(","  LoginState(","    email: \"blob@pointfree.co\",","    password: \"bl0bisawesome!\",","    token: \"secret\"","  )",")"],"type":"codeListing","syntax":"swift"},{"code":["LoginState(","  email: \"blob@pointfree.co\",","  password: <redacted>",")"],"type":"codeListing","syntax":"text"},{"type":"paragraph","inlineContent":[{"text":"Now the dump retains the fact that a password field exists, but it prevents the underlying value","type":"text"},{"type":"text","text":" "},{"type":"text","text":"from being logged."}]},{"level":2,"type":"heading","text":"Overriding a structure’s dump representation","anchor":"Overriding-a-structures-dump-representation"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Massaging the data inside a structure is just one way to use a custom mirror. A mirror can also"},{"type":"text","text":" "},{"type":"text","text":"let you completely transform the "},{"type":"emphasis","inlineContent":[{"type":"text","text":"way"}]},{"type":"text","text":" a structure is dumped."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"For example, a wrapper type can be flattened to dump the wrapped value by providing the wrapped"},{"type":"text","text":" "},{"type":"text","text":"value’s mirror:"}]},{"code":["struct Todos: CustomDumpReflectable {","  var rawValue: [Todo] = []","","  var customDumpMirror: Mirror {","    .init(reflecting: self.rawValue)","  }","}","","customDump(Todos())"],"type":"codeListing","syntax":"swift"},{"code":["[]"],"type":"codeListing","syntax":"text"}],"kind":"content"}],"hierarchy":{"paths":[["doc:\/\/CustomDump\/documentation\/CustomDump"]]},"metadata":{"roleHeading":"Protocol","symbolKind":"protocol","role":"symbol","title":"CustomDumpReflectable","externalID":"s:10CustomDump0aB11ReflectableP","fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"CustomDumpReflectable"}],"modules":[{"name":"CustomDump"}],"navigatorTitle":[{"text":"CustomDumpReflectable","kind":"identifier"}]},"sections":[],"topicSections":[{"identifiers":["doc:\/\/CustomDump\/documentation\/CustomDump\/CustomDumpReflectable\/customDumpMirror"],"title":"Instance Properties","generated":true,"anchor":"Instance-Properties"}],"kind":"symbol","abstract":[{"text":"A type that explicitly supplies its own mirror for ","type":"text"},{"identifier":"doc:\/\/CustomDump\/documentation\/CustomDump\/customDump(_:to:name:indent:maxDepth:)","type":"reference","isActive":true},{"text":" ","type":"text"},{"text":"and ","type":"text"},{"identifier":"doc:\/\/CustomDump\/documentation\/CustomDump\/diff(_:_:format:)","type":"reference","isActive":true},{"text":".","type":"text"}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/CustomDump\/documentation\/CustomDump\/CustomDumpReflectable"},"references":{"doc://CustomDump/documentation/CustomDump/CustomDumpRepresentable":{"fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"t
{"abstract":[{"type":"text","text":"While SnapshotTesting comes with a wide variety of snapshot strategies, it can also be extended with"},{"type":"text","text":" "},{"type":"text","text":"custom, user-defined strategies using the "},{"identifier":"doc:\/\/SnapshotTesting\/documentation\/SnapshotTesting\/Snapshotting","type":"reference","isActive":true},{"type":"text","text":" and"},{"type":"text","text":" "},{"identifier":"doc:\/\/SnapshotTesting\/documentation\/SnapshotTesting\/Diffing","type":"reference","isActive":true},{"type":"text","text":" types."}],"metadata":{"modules":[{"name":"SnapshotTesting"}],"roleHeading":"Article","role":"article","title":"Defining custom snapshot strategies"},"seeAlsoSections":[{"generated":true,"identifiers":["doc:\/\/SnapshotTesting\/documentation\/SnapshotTesting\/Snapshotting","doc:\/\/SnapshotTesting\/documentation\/SnapshotTesting\/Diffing","doc:\/\/SnapshotTesting\/documentation\/SnapshotTesting\/Async"],"anchor":"Strategies","title":"Strategies"}],"sections":[],"hierarchy":{"paths":[["doc:\/\/SnapshotTesting\/documentation\/SnapshotTesting"]]},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/snapshottesting\/customstrategies"]}],"schemaVersion":{"minor":3,"patch":0,"major":0},"kind":"article","identifier":{"interfaceLanguage":"swift","url":"doc:\/\/SnapshotTesting\/documentation\/SnapshotTesting\/CustomStrategies"},"primaryContentSections":[{"kind":"content","content":[{"level":2,"type":"heading","anchor":"Snapshotting","text":"Snapshotting"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The "},{"identifier":"doc:\/\/SnapshotTesting\/documentation\/SnapshotTesting\/Snapshotting","type":"reference","isActive":true},{"type":"text","text":" type represents the ability to transform a snapshottable value"},{"type":"text","text":" "},{"type":"text","text":"(like a view or data structure) into a diffable format (like an image or text)."}]},{"level":3,"type":"heading","anchor":"Transforming-existing-strategies","text":"Transforming existing strategies"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Existing strategies can be transformed to work with new types using the "},{"type":"codeVoice","code":"pullback"},{"type":"text","text":" method."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"For example, given the following "},{"type":"codeVoice","code":"image"},{"type":"text","text":" strategy on "},{"type":"codeVoice","code":"UIView"},{"type":"text","text":":"}]},{"code":["Snapshotting<UIView, UIImage>.image"],"syntax":"swift","type":"codeListing"},{"type":"paragraph","inlineContent":[{"type":"text","text":"We can define an "},{"type":"codeVoice","code":"image"},{"type":"text","text":" strategy on "},{"type":"codeVoice","code":"UIViewController"},{"type":"text","text":" using the "},{"type":"codeVoice","code":"pullback"},{"type":"text","text":" method:"}]},{"code":["extension Snapshotting where Value: UIViewController, Format == UIImage {","  public static let image: Snapshotting = Snapshotting<UIView, UIImage>","    .image","    .pullback { viewController in viewController.view }","}"],"syntax":"swift","type":"codeListing"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Pullback takes a transform function from the new strategy’s value to the existing strategy’s value,"},{"type":"text","text":" "},{"type":"text","text":"in this case "},{"type":"codeVoice","code":"(UIViewController) -> UIView"},{"type":"text","text":"."}]},{"level":3,"type":"heading","anchor":"Creating-brand-new-strategies","text":"Creating brand new strategies"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Most strategies can be built from existing ones, but if you’ve defined your own"},{"type":"text","text":" "},{"identifier":"doc:\/\/SnapshotTesting\/documentation\/SnapshotTesting\/Diffing","type":"reference","isActive":true},{"type":"text","text":" strategy, you may need to create a base "},{"identifier":"doc:\/\/SnapshotTesting\/documentation\/SnapshotTesting\/Snapshotting","type":"reference","isActive":true},{"type":"text","text":" "},{"type":"text","text":"value alongside it."}]},{"level":3,"type":"heading","anchor":"Asynchronous-Strategies","text":"Asynchronous Strategies"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Some types need to be snapshot in an asynchronous fashion. "},{"identifier":"doc:\/\/SnapshotTesting\/documentation\/SnapshotTesting\/Snapshotting","type":"reference","isActive":true},{"type":"text","text":" offers"},{"type":"text","text":" "},{"type":"text","text":"two APIs for building asynchronous strategies by utilizing a built-in "},{"identifier":"doc:\/\/SnapshotTesting\/documentation\/SnapshotTesting\/Async","type":"reference","isActive":true},{"type":"text","text":" type."}]},{"level":4,"type":"heading","anchor":"Async-pullbacks","text":"Async pullbacks"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Alongside "},{"identifier":"doc:\/\/SnapshotTesting\/documentation\/SnapshotTesting\/Snapshotting\/pullback(_:)","type":"reference","isActive":true},{"type":"text","text":" there is "},{"identifier":"doc:\/\/SnapshotTesting\/documentation\/SnapshotTesting\/Snapshotting\/asyncPullback(_:)","type":"reference","isActive":true},{"type":"text","text":", which takes a"},{"type":"text","text":" "},{"type":"text","text":"transform function "},{"type":"codeVoice","code":"(NewStrategyValue) -> Async<ExistingStrategyValue>"},{"type":"text","text":"."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"For example, WebKit’s "},{"type":"codeVoice","code":"WKWebView"},{"type":"text","text":" offers a callback-based API for taking image snapshots, where the"},{"type":"text","text":" "},{"type":"text","text":"image is passed asynchronously to the callback block. While "},{"type":"codeVoice","code":"pullback"},{"type":"text","text":" would require the "},{"type":"codeVoice","code":"UIImage"},{"type":"text","text":" "},{"type":"text","text":"to be returned from the transform function, "},{"type":"codeVoice","code":"asyncPullback"},{"type":"text","text":" and "},{"type":"codeVoice","code":"Async"},{"type":"text","text":" allow us to pass the "},{"type":"codeVoice","code":"image"},{"type":"text","text":" "},{"type":"text","text":"a value that can pass its callback along to the scope in which the image has been created."}]},{"code":["extension Snapshotting where Value == WKWebView, Format == UIImage {","  public static let image: Snapshotting = Snapshotting<UIImage, UIImage>","    .image","    .asyncPullback { webView in","      Async { callback in","        webView.takeSnapshot(with: nil) { image, error in","          callback(image!)","        }","      }","  }","}"],"syntax":"swift","type":"codeListing"},{"level":4,"type":"heading","anchor":"Async-initialization","text":"Async initialization"},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"Snapshotting"},{"type":"text","text":" defines an alternate initializer to describe snapshotting values in an asynchronous"},{"type":"text","text":" "},{"type":"text","text":"fashion."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"For example, were we to define a strategy for "},{"type":"codeVoice","code":"WKWebView"},{"type":"text","text":" "},{"type":"emphasis","inlineContent":[{"type":"text","text":"without"}]},{"type":"text","text":" "},{"type":"reference","isActive":true,"identifier":"doc:\/\/SnapshotTesting\/documentation\/SnapshotTesting\/Snapshotting\/asyncPullback(_:)"},{"type":"text","text":":"}]},{"code":["extension Snapshotting where Value == WKWebView, Format == UIImage {","  public static let image = Snapshotting(","    pathExtension: \"png\",","    diffing: .image,","    asyncSnapshot: { webView in","      Async { callback in","        webView.takeSnapshot(with: nil) { image, error in","          callback(image!)","        }","      }","    }","  )","}"],"syntax":"swift","type":"codeListing"},{"level":2,"type":"heading","anchor":"Diffing","text":"Diffing"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The "},{"type":"reference","isActive":true,"identifier":"doc:\/\/SnapshotTesting\/documentation\/SnapshotTesting\/Diffing"},{"type":"text","text":" type represents the ability to compare "},{"type":"codeVoice","code":"Value"},{"type":"text","text":"s and convert them to"},{"type":"text","text":" "},{"type":"text","text":"and from "},{"type":"codeVoice","code":"Data"},{"type":"text","text":"."}]}]}],"references":{"doc://SnapshotTesting/documentation/SnapshotTesting":{"title":"SnapshotTesting","identifier":"doc:\/\/SnapshotTesting\/documentation\/SnapshotTesting","abstract":[{"text":"Powerfully flexible snapshot testing.","type":"text"}],"url":"\/documentation\/snapshottesting","type":"topic","role":"collection","kind":"symbol"},"doc://SnapshotTesting/documentation/SnapshotTesting/Diffing":{"abstract":[{"text":"The ability to compare ","type":"text"},{"type":"codeVoice","code":"Value"},{"text":"s and convert them to and from ","type":"text"},{"type":"codeVoice","code":"Data"},{"text":".","type":"text"}],"navigatorTitle":[{"text":"Diffing","kind":"identifier"}],"identifier":"doc:\/\/SnapshotTesting\/documentation\/SnapshotTesting\/Diffing","url":"\/documentation\/snapshottesting\/diffing","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Diffing","kind":"identifier"}],"type":"topic","kind":"symbol","role":"symbol","title":"Diffing"},"doc://SnapshotTesting/documentation/SnapshotTesting/Async":{"abstract":[{"text":"A wrapper around an asynchronous operation.","type":"text"}],"navigatorTitle":[{"text":"Async","kind":"identifier"}],"identifier":"doc:\/\/SnapshotTesting\/documentation\/SnapshotTesting\/Async","url":"\/documentation\/snapshottesting\/async","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Async","kind":"identifier"}],"type":"topic","kind":"symbol","role":"symbol","title":"Async"},"doc://Sna
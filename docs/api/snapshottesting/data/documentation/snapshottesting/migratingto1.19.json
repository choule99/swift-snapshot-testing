{"abstract":[{"text":"Update custom ","type":"text"},{"isActive":true,"identifier":"doc:\/\/SnapshotTesting\/documentation\/SnapshotTesting\/Diffing","type":"reference"},{"text":" strategies to support Swift Testing attachments.","type":"text"}],"identifier":{"url":"doc:\/\/SnapshotTesting\/documentation\/SnapshotTesting\/MigratingTo1.19","interfaceLanguage":"swift"},"kind":"article","variants":[{"paths":["\/documentation\/snapshottesting\/migratingto1.19"],"traits":[{"interfaceLanguage":"swift"}]}],"primaryContentSections":[{"kind":"content","content":[{"anchor":"Overview","text":"Overview","level":2,"type":"heading"},{"inlineContent":[{"type":"text","text":"Prior to 1.19, the "},{"type":"reference","isActive":true,"identifier":"doc:\/\/SnapshotTesting\/documentation\/SnapshotTesting\/Diffing"},{"type":"text","text":" type’s "},{"type":"codeVoice","code":"diff"},{"type":"text","text":" closure returned "},{"type":"codeVoice","code":"[XCTAttachment]"},{"type":"text","text":" to describe"},{"type":"text","text":" "},{"type":"text","text":"failure artifacts (such as reference images, failure images, and difference images). This meant that"},{"type":"text","text":" "},{"type":"text","text":"when running tests in Swift Testing, these attachments could not be surfaced because "},{"type":"codeVoice","code":"XCTAttachment"},{"type":"text","text":" "},{"type":"text","text":"is an XCTest-only type."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Version 1.19 introduces a new "},{"type":"reference","isActive":true,"identifier":"doc:\/\/SnapshotTesting\/documentation\/SnapshotTesting\/DiffAttachment"},{"type":"text","text":" enum and updated APIs so that failure artifacts are"},{"type":"text","text":" "},{"type":"text","text":"automatically surfaced as Swift Testing"},{"type":"text","text":" "},{"type":"reference","isActive":true,"identifier":"https:\/\/developer.apple.com\/documentation\/testing\/attachment"},{"type":"text","text":" when tests are run in"},{"type":"text","text":" "},{"type":"text","text":"a "},{"type":"codeVoice","code":"@Test"},{"type":"text","text":"."}],"type":"paragraph"},{"anchor":"Updating-custom-Diffing-strategies","text":"Updating custom `Diffing` strategies","level":2,"type":"heading"},{"inlineContent":[{"type":"text","text":"If you have defined a custom "},{"type":"reference","isActive":true,"identifier":"doc:\/\/SnapshotTesting\/documentation\/SnapshotTesting\/Diffing"},{"type":"text","text":" strategy, you will need to update it to use the new"},{"type":"text","text":" "},{"identifier":"doc:\/\/SnapshotTesting\/documentation\/SnapshotTesting\/Diffing\/diff(toData:fromData:diffV2:)","type":"reference","isActive":true},{"type":"text","text":" static method and return "},{"identifier":"doc:\/\/SnapshotTesting\/documentation\/SnapshotTesting\/DiffAttachment","type":"reference","isActive":true},{"text":" values","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"instead of "},{"type":"codeVoice","code":"XCTAttachment"},{"type":"text","text":"s."}],"type":"paragraph"},{"numberOfColumns":2,"type":"row","columns":[{"size":1,"content":[{"type":"codeListing","syntax":"swift","code":["\/\/ Before","","extension Diffing where Value == MyImage {","  static let myImage = Diffing(","    toData: { $0.pngData()! },","    fromData: { MyImage(data: $0)! }","  ) { old, new in","    guard old != new else { return nil }","    let oldAttachment = XCTAttachment(image: old)","    oldAttachment.name = \"reference\"","    let newAttachment = XCTAttachment(image: new)","    newAttachment.name = \"failure\"","    return (","      \"Images did not match\",","      [oldAttachment, newAttachment]","    )","  }","}"]}]},{"size":1,"content":[{"type":"codeListing","syntax":"swift","code":["\/\/ After","","extension Diffing where Value == MyImage {","  static let myImage = Diffing.diff(","    toData: { $0.pngData()! },","    fromData: { MyImage(data: $0)! }","  ) { old, new in","    guard old != new else { return nil }","    return (","      \"Images did not match\",","      [","        .data(old.pngData()!, name: \"reference.png\"),","        .data(new.pngData()!, name: \"failure.png\"),","      ]","    )","  }","}"]}]}]},{"type":"paragraph","inlineContent":[{"text":"The changes are:","type":"text"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"Use ","type":"text"},{"identifier":"doc:\/\/SnapshotTesting\/documentation\/SnapshotTesting\/Diffing\/diff(toData:fromData:diffV2:)","type":"reference","isActive":true},{"text":" instead of ","type":"text"},{"type":"codeVoice","code":"Diffing.init(toData:fromData:diff:)"},{"text":".","type":"text"},{"text":" ","type":"text"},{"text":"The initializer is now deprecated.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Return ","type":"text"},{"identifier":"doc:\/\/SnapshotTesting\/documentation\/SnapshotTesting\/DiffAttachment","type":"reference","isActive":true},{"text":" values instead of ","type":"text"},{"type":"codeVoice","code":"XCTAttachment"},{"text":". The ","type":"text"},{"identifier":"doc:\/\/SnapshotTesting\/documentation\/SnapshotTesting\/DiffAttachment","type":"reference","isActive":true},{"text":" enum has","type":"text"},{"text":" ","type":"text"},{"text":"two cases:","type":"text"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"reference","isActive":true,"identifier":"doc:\/\/SnapshotTesting\/documentation\/SnapshotTesting\/DiffAttachment\/data(_:name:)"},{"type":"text","text":": Provides raw "},{"type":"codeVoice","code":"Data"},{"type":"text","text":" and a file name. This is the preferred"},{"type":"text","text":" "},{"type":"text","text":"case because it works in both XCTest and Swift Testing contexts. The library will"},{"type":"text","text":" "},{"type":"text","text":"automatically convert it to the appropriate attachment type for the active test runner."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"reference","isActive":true,"identifier":"doc:\/\/SnapshotTesting\/documentation\/SnapshotTesting\/DiffAttachment\/xcTest(_:)"},{"type":"text","text":": Wraps an "},{"type":"codeVoice","code":"XCTAttachment"},{"type":"text","text":" directly. This case is provided for"},{"type":"text","text":" "},{"text":"backwards compatibility, but attachments wrapped this way will ","type":"text"},{"inlineContent":[{"type":"text","text":"not"}],"type":"strong"},{"type":"text","text":" appear in Swift Testing"},{"text":" ","type":"text"},{"type":"text","text":"results."}],"type":"paragraph"}]}]}]}]},{"type":"heading","anchor":"Accessing-diffV2-directly","text":"Accessing `diffV2` directly","level":2},{"inlineContent":[{"type":"text","text":"If you are accessing the "},{"type":"codeVoice","code":"diff"},{"type":"text","text":" property on an existing "},{"identifier":"doc:\/\/SnapshotTesting\/documentation\/SnapshotTesting\/Diffing","type":"reference","isActive":true},{"type":"text","text":" value, it has been deprecated"},{"type":"text","text":" "},{"type":"text","text":"in favor of "},{"identifier":"doc:\/\/SnapshotTesting\/documentation\/SnapshotTesting\/Diffing\/diffV2","type":"reference","isActive":true},{"type":"text","text":", which returns "},{"type":"codeVoice","code":"[DiffAttachment]"},{"type":"text","text":" instead of "},{"type":"codeVoice","code":"[XCTAttachment]"},{"type":"text","text":":"}],"type":"paragraph"},{"type":"row","columns":[{"content":[{"syntax":"swift","type":"codeListing","code":["\/\/ Before","","if let (message, attachments) =","  diffing.diff(expected, actual) {","  \/\/ attachments: [XCTAttachment]","}"]}],"size":1},{"size":1,"content":[{"syntax":"swift","type":"codeListing","code":["\/\/ After","","if let (message, attachments) =","  diffing.diffV2(expected, actual) {","  \/\/ attachments: [DiffAttachment]","}"]}]}],"numberOfColumns":2},{"anchor":"Backwards-compatibility","type":"heading","level":2,"text":"Backwards compatibility"},{"type":"p
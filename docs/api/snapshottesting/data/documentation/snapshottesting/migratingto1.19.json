{"metadata":{"modules":[{"name":"SnapshotTesting"}],"roleHeading":"Article","role":"article","title":"Migrating to 1.19"},"kind":"article","primaryContentSections":[{"content":[{"text":"Overview","type":"heading","level":2,"anchor":"Overview"},{"type":"paragraph","inlineContent":[{"text":"Prior to 1.19, the ","type":"text"},{"type":"reference","identifier":"doc:\/\/SnapshotTesting\/documentation\/SnapshotTesting\/Diffing","isActive":true},{"text":" type’s ","type":"text"},{"type":"codeVoice","code":"diff"},{"text":" closure returned ","type":"text"},{"type":"codeVoice","code":"[XCTAttachment]"},{"text":" to describe","type":"text"},{"text":" ","type":"text"},{"text":"failure artifacts (such as reference images, failure images, and difference images). This meant that","type":"text"},{"text":" ","type":"text"},{"text":"when running tests in Swift Testing, these attachments could not be surfaced because ","type":"text"},{"type":"codeVoice","code":"XCTAttachment"},{"text":" ","type":"text"},{"text":"is an XCTest-only type.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Version 1.19 introduces a new "},{"identifier":"doc:\/\/SnapshotTesting\/documentation\/SnapshotTesting\/DiffAttachment","type":"reference","isActive":true},{"type":"text","text":" enum and updated APIs so that failure artifacts are"},{"type":"text","text":" "},{"type":"text","text":"automatically surfaced as Swift Testing"},{"type":"text","text":" "},{"identifier":"https:\/\/developer.apple.com\/documentation\/testing\/attachment","type":"reference","isActive":true},{"type":"text","text":" when tests are run in"},{"type":"text","text":" "},{"type":"text","text":"a "},{"code":"@Test","type":"codeVoice"},{"text":".","type":"text"}]},{"type":"heading","text":"Updating custom `Diffing` strategies","level":2,"anchor":"Updating-custom-Diffing-strategies"},{"type":"paragraph","inlineContent":[{"text":"If you have defined a custom ","type":"text"},{"identifier":"doc:\/\/SnapshotTesting\/documentation\/SnapshotTesting\/Diffing","type":"reference","isActive":true},{"text":" strategy, you will need to update it to use the new","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/SnapshotTesting\/documentation\/SnapshotTesting\/Diffing\/diff(toData:fromData:diffV2:)","type":"reference","isActive":true},{"text":" static method and return ","type":"text"},{"identifier":"doc:\/\/SnapshotTesting\/documentation\/SnapshotTesting\/DiffAttachment","type":"reference","isActive":true},{"text":" values","type":"text"},{"text":" ","type":"text"},{"text":"instead of ","type":"text"},{"code":"XCTAttachment","type":"codeVoice"},{"text":"s.","type":"text"}]},{"type":"row","numberOfColumns":2,"columns":[{"size":1,"content":[{"syntax":"swift","code":["\/\/ Before","","extension Diffing where Value == MyImage {","  static let myImage = Diffing(","    toData: { $0.pngData()! },","    fromData: { MyImage(data: $0)! }","  ) { old, new in","    guard old != new else { return nil }","    let oldAttachment = XCTAttachment(image: old)","    oldAttachment.name = \"reference\"","    let newAttachment = XCTAttachment(image: new)","    newAttachment.name = \"failure\"","    return (","      \"Images did not match\",","      [oldAttachment, newAttachment]","    )","  }","}"],"type":"codeListing"}]},{"size":1,"content":[{"type":"codeListing","code":["\/\/ After","","extension Diffing where Value == MyImage {","  static let myImage = Diffing.diff(","    toData: { $0.pngData()! },","    fromData: { MyImage(data: $0)! }","  ) { old, new in","    guard old != new else { return nil }","    return (","      \"Images did not match\",","      [","        .data(old.pngData()!, name: \"reference.png\"),","        .data(new.pngData()!, name: \"failure.png\"),","      ]","    )","  }","}"],"syntax":"swift"}]}]},{"type":"paragraph","inlineContent":[{"text":"The changes are:","type":"text"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"text","text":"Use "},{"type":"reference","isActive":true,"identifier":"doc:\/\/SnapshotTesting\/documentation\/SnapshotTesting\/Diffing\/diff(toData:fromData:diffV2:)"},{"type":"text","text":" instead of "},{"type":"codeVoice","code":"Diffing.init(toData:fromData:diff:)"},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"text","text":"The initializer is now deprecated."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Return "},{"identifier":"doc:\/\/SnapshotTesting\/documentation\/SnapshotTesting\/DiffAttachment","isActive":true,"type":"reference"},{"text":" values instead of ","type":"text"},{"code":"XCTAttachment","type":"codeVoice"},{"text":". The ","type":"text"},{"identifier":"doc:\/\/SnapshotTesting\/documentation\/SnapshotTesting\/DiffAttachment","isActive":true,"type":"reference"},{"text":" enum has","type":"text"},{"text":" ","type":"text"},{"text":"two cases:","type":"text"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"reference","identifier":"doc:\/\/SnapshotTesting\/documentation\/SnapshotTesting\/DiffAttachment\/data(_:name:)","isActive":true},{"type":"text","text":": Provides raw "},{"code":"Data","type":"codeVoice"},{"type":"text","text":" and a file name. This is the preferred"},{"type":"text","text":" "},{"type":"text","text":"case because it works in both XCTest and Swift Testing contexts. The library will"},{"type":"text","text":" "},{"type":"text","text":"automatically convert it to the appropriate attachment type for the active test runner."}]}]},{"content":[{"inlineContent":[{"identifier":"doc:\/\/SnapshotTesting\/documentation\/SnapshotTesting\/DiffAttachment\/xcTest(_:)","type":"reference","isActive":true},{"text":": Wraps an ","type":"text"},{"type":"codeVoice","code":"XCTAttachment"},{"text":" directly. This case is provided for","type":"text"},{"text":" ","type":"text"},{"text":"backwards compatibility, but attachments wrapped this way will ","type":"text"},{"type":"strong","inlineContent":[{"text":"not","type":"text"}]},{"text":" appear in Swift Testing","type":"text"},{"text":" ","type":"text"},{"text":"results.","type":"text"}],"type":"paragraph"}]}]}]}]},{"type":"heading","level":2,"text":"Accessing `diffV2` directly","anchor":"Accessing-diffV2-directly"},{"type":"paragraph","inlineContent":[{"type":"text","text":"If you are accessing the "},{"code":"diff","type":"codeVoice"},{"type":"text","text":" property on an existing "},{"identifier":"doc:\/\/SnapshotTesting\/documentation\/SnapshotTesting\/Diffing","isActive":true,"type":"reference"},{"text":" value, it has been deprecated","type":"text"},{"type":"text","text":" "},{"type":"text","text":"in favor of "},{"identifier":"doc:\/\/SnapshotTesting\/documentation\/SnapshotTesting\/Diffing\/diffV2","type":"reference","isActive":true},{"type":"text","text":", which returns "},{"code":"[DiffAttachment]","type":"codeVoice"},{"text":" instead of ","type":"text"},{"type":"codeVoice","code":"[XCTAttachment]"},{"text":":","type":"text"}]},{"type":"row","columns":[{"content":[{"type":"codeListing","code":["\/\/ Before","","if let (message, attachments) =","  diffing.diff(expected, actual) {","  \/\/ attachments: [XCTAttachment]","}"],"syntax":"swift"}],"size":1},{"content":[{"type":"codeListing","code":["\/\/ After","","if let (message, attachments) =","  diffing.diffV2(expected, actual) {","  \/\/ attachments: [DiffAttachment]","}"],"syntax":"swift"}],"size":1}],"numberOfColumns":2},{"type":"heading","anchor":"Backwards-compatibility","level":2,"text":"Backwards compatibility"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The deprecated "},{"code":"diff","type":"codeVoice"},{"type":"text","text":" property and initializer continue to work. If you are not yet ready to"},{"type":"text","text":" "},{"type":"text","text":"migrate, your existing custom diffing strategies will compile with a deprecation warning. However,"},{"type":"text","text":" "},{"type":"text","text":"attachments created through the deprecated path will only appear in XCTest results, not in Swift"},{"type":"text","text":" "},{"type":"text","text":"Testing."}]}],"kind":"content"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/snapshottesting\/migratingto1.19"]}],"abstract":[{"text":"Update custom ","type":"text"},{"isActive":true,"identifier":"doc:\/\/SnapshotTesting\/documentation\/SnapshotTesting\/Diffing","type":"reference"},{"text":" strategies to support Swift Testing attachments.","type":"text"}],"hierarchy":{"paths":[["doc:\/\/SnapshotTesting\/documentation\/SnapshotTesting"]]},"sections":[],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/SnapshotTesting\/documentation\/SnapshotTesting\/MigratingTo1.19"},"schemaVersion":{"patch":0,"minor":3,"major":0},"references":{"doc://SnapshotTesting/documentation/SnapshotTesting/DiffAttachment/xcTest(_:)":{"role":"symbol","deprecated":true,"type":"topic","kind":"symbol","title":"DiffAttachment.xcTest(_:)","url":"\/documentation\/snapshottesting\/diffattachment\/xctest(_:)","abstract":[],"identifier":"doc:\/\/SnapshotTesting\/documentation\/SnapshotTesting\/DiffAttachment\/xcTest(_:)","fragments":[{"text":"case","kind":"keyword"},{"text":" ","kind":"text"},{"text":"xcTest","kind":"identifier"},{"text":"(","kind":"text"},{"text":"XCTAttachment","preciseIdentifier":"c:objc(cs)XCTAttachment","kind":"typeIdentifier"},{"text":")","kind":"text"}]},"doc://SnapshotTesting/documentation/SnapshotTesting/DiffAttachment/data(_:name:)":{"abstract":[],"url":"\/documentation\/snapshottesting\/diffattachment\/data(_:name:)","title":"DiffAttachment.data(_:name:)","identifier":"doc:\/\/SnapshotTesting\/documentation\/SnapshotTesting\/DiffAttachment\/data(_:name:)","role":"symbol","fragments":[{"kind":"keyword","text":"case"},{"kind":"text","text":" "},{"kind":"identifier","text":"data"},{"kind":"text","text":"("},{"kind":"typeIdentifier","preciseIdentifier":"s:10Foundation4Dat
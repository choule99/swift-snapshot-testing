{"hierarchy":{"paths":[["doc:\/\/SnapshotTesting\/documentation\/SnapshotTesting"]]},"abstract":[{"text":"Update custom ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/SnapshotTesting\/documentation\/SnapshotTesting\/Diffing"},{"text":" strategies to support Swift Testing attachments.","type":"text"}],"primaryContentSections":[{"content":[{"text":"Overview","type":"heading","anchor":"Overview","level":2},{"inlineContent":[{"type":"text","text":"Prior to 1.19, the "},{"identifier":"doc:\/\/SnapshotTesting\/documentation\/SnapshotTesting\/Diffing","type":"reference","isActive":true},{"type":"text","text":" type’s "},{"type":"codeVoice","code":"diff"},{"type":"text","text":" closure returned "},{"type":"codeVoice","code":"[XCTAttachment]"},{"type":"text","text":" to describe"},{"type":"text","text":" "},{"type":"text","text":"failure artifacts (such as reference images, failure images, and difference images). This meant that"},{"type":"text","text":" "},{"type":"text","text":"when running tests in Swift Testing, these attachments could not be surfaced because "},{"type":"codeVoice","code":"XCTAttachment"},{"type":"text","text":" "},{"type":"text","text":"is an XCTest-only type."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Version 1.19 introduces a new "},{"identifier":"doc:\/\/SnapshotTesting\/documentation\/SnapshotTesting\/DiffAttachment","type":"reference","isActive":true},{"type":"text","text":" enum and updated APIs so that failure artifacts are"},{"type":"text","text":" "},{"type":"text","text":"automatically surfaced as Swift Testing"},{"type":"text","text":" "},{"type":"reference","isActive":true,"identifier":"https:\/\/developer.apple.com\/documentation\/testing\/attachment"},{"type":"text","text":" when tests are run in"},{"type":"text","text":" "},{"type":"text","text":"a "},{"type":"codeVoice","code":"@Test"},{"type":"text","text":"."}],"type":"paragraph"},{"text":"Updating custom `Diffing` strategies","type":"heading","anchor":"Updating-custom-Diffing-strategies","level":2},{"inlineContent":[{"type":"text","text":"If you have defined a custom "},{"identifier":"doc:\/\/SnapshotTesting\/documentation\/SnapshotTesting\/Diffing","type":"reference","isActive":true},{"type":"text","text":" strategy, you will need to update it to use the new"},{"type":"text","text":" "},{"type":"reference","isActive":true,"identifier":"doc:\/\/SnapshotTesting\/documentation\/SnapshotTesting\/Diffing\/diff(toData:fromData:diffV2:)"},{"type":"text","text":" static method and return "},{"type":"reference","isActive":true,"identifier":"doc:\/\/SnapshotTesting\/documentation\/SnapshotTesting\/DiffAttachment"},{"type":"text","text":" values"},{"type":"text","text":" "},{"type":"text","text":"instead of "},{"type":"codeVoice","code":"XCTAttachment"},{"type":"text","text":"s."}],"type":"paragraph"},{"type":"row","numberOfColumns":2,"columns":[{"size":1,"content":[{"syntax":"swift","code":["\/\/ Before","","extension Diffing where Value == MyImage {","  static let myImage = Diffing(","    toData: { $0.pngData()! },","    fromData: { MyImage(data: $0)! }","  ) { old, new in","    guard old != new else { return nil }","    let oldAttachment = XCTAttachment(image: old)","    oldAttachment.name = \"reference\"","    let newAttachment = XCTAttachment(image: new)","    newAttachment.name = \"failure\"","    return (","      \"Images did not match\",","      [oldAttachment, newAttachment]","    )","  }","}"],"type":"codeListing"}]},{"size":1,"content":[{"syntax":"swift","code":["\/\/ After","","extension Diffing where Value == MyImage {","  static let myImage = Diffing.diff(","    toData: { $0.pngData()! },","    fromData: { MyImage(data: $0)! }","  ) { old, new in","    guard old != new else { return nil }","    return (","      \"Images did not match\",","      [","        .data(old.pngData()!, name: \"reference.png\"),","        .data(new.pngData()!, name: \"failure.png\"),","      ]","    )","  }","}"],"type":"codeListing"}]}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The changes are:"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"text":"Use ","type":"text"},{"isActive":true,"identifier":"doc:\/\/SnapshotTesting\/documentation\/SnapshotTesting\/Diffing\/diff(toData:fromData:diffV2:)","type":"reference"},{"text":" instead of ","type":"text"},{"code":"Diffing.init(toData:fromData:diff:)","type":"codeVoice"},{"text":".","type":"text"},{"text":" ","type":"text"},{"text":"The initializer is now deprecated.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Return ","type":"text"},{"isActive":true,"identifier":"doc:\/\/SnapshotTesting\/documentation\/SnapshotTesting\/DiffAttachment","type":"reference"},{"text":" values instead of ","type":"text"},{"code":"XCTAttachment","type":"codeVoice"},{"text":". The ","type":"text"},{"isActive":true,"identifier":"doc:\/\/SnapshotTesting\/documentation\/SnapshotTesting\/DiffAttachment","type":"reference"},{"text":" enum has","type":"text"},{"text":" ","type":"text"},{"text":"two cases:","type":"text"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"reference","identifier":"doc:\/\/SnapshotTesting\/documentation\/SnapshotTesting\/DiffAttachment\/data(_:name:)","isActive":true},{"type":"text","text":": Provides raw "},{"code":"Data","type":"codeVoice"},{"type":"text","text":" and a file name. This is the preferred"},{"type":"text","text":" "},{"type":"text","text":"case because it works in both XCTest and Swift Testing contexts. The library will"},{"type":"text","text":" "},{"type":"text","text":"automatically convert it to the appropriate attachment type for the active test runner."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"reference","identifier":"doc:\/\/SnapshotTesting\/documentation\/SnapshotTesting\/DiffAttachment\/xcTest(_:)","isActive":true},{"type":"text","text":": Wraps an "},{"code":"XCTAttachment","type":"codeVoice"},{"type":"text","text":" directly. This case is provided for"},{"type":"text","text":" "},{"type":"text","text":"backwards compatibility, but attachments wrapped this way will "},{"type":"strong","inlineContent":[{"text":"not","type":"text"}]},{"type":"text","text":" appear in Swift Testing"},{"type":"text","text":" "},{"type":"text","text":"results."}],"type":"paragraph"}]}]}]}]},{"type":"heading","anchor":"Accessing-diffV2-directly","text":"Accessing `diffV2` directly","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"If you are accessing the "},{"type":"codeVoice","code":"diff"},{"type":"text","text":" property on an existing "},{"identifier":"doc:\/\/SnapshotTesting\/documentation\/SnapshotTesting\/Diffing","type":"reference","isActive":true},{"type":"text","text":" value, it has been deprecated"},{"type":"text","text":" "},{"type":"text","text":"in favor of "},{"identifier":"doc:\/\/SnapshotTesting\/documentation\/SnapshotTesting\/Diffing\/diffV2","type":"reference","isActive":true},{"type":"text","text":", which returns "},{"type":"codeVoice","code":"[DiffAttachment]"},{"type":"text","text":" instead of "},{"type":"codeVoice","code":"[XCTAttachment]"},{"type":"text","text":":"}]},{"type":"row","numberOfColumns":2,"columns":[{"size":1,"content":[{"syntax":"swift","code":["\/\/ Before","","if let (message, attachments) =","  diffing.diff(expected, actual) {","  \/\/ attachments: [XCTAttachment]","}"],"type":"codeListing"}]},{"size":1,"content":[{"syntax":"swift","code":["\/\/ After","","if let (message, attachments) =","  diffing.diffV2(expected, actual) {","  \/\/ attachments: [DiffAttachment]","}"],"type":"codeListing"}]}]},{"type":"heading","anchor":"Backwards-compatibility","text":"Backwards compatibility","level":2},{"type":"paragraph","inlineContent":[{"text":"The deprecated ","type":"text"},{"code":"diff","type":"codeVoice"},{"text":" property and initializer continue to work. If you are not yet ready to","type":"text"},{"text":" ","type":"text"},{"text":"migrate, your existing custom diffing strategies will compile with a deprecation warning. However,","type":"text"},{"text":" ","type":"text"},{"text":"attachments created through the deprecated path will only appear in XCTest results, not in Swift","type":"text"},{"text":" ","type":"text"},{"text":"Testing.","type":"text"}]}],"kind":"content"}],"metadata":{"modules":[{"name":"SnapshotTesting"}],"role":"article","roleHeading":"Article","title":"Migrating to 1.19"},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/snapshottesting\/migratingto1.19"]}],"kind":"article","sections":[],"schemaVersion":{"patch":0,"major":0,"minor":3},"identifier":{"url":"doc:\/\/SnapshotTesting\/documentation\/SnapshotTesting\/MigratingTo1.19","interfaceLanguage":"swift"},"references":{"doc://SnapshotTesting/documentation/SnapshotTesting/DiffAttachment/xcTest(_:)":{"type":"topic","role":"symbol","title":"DiffAttachment.xcTest(_:)","url":"\/documentation\/snapshottesting\/diffattachment\/xctest(_:)","identifier":"doc:\/\/SnapshotTesting\/documentation\/SnapshotTesting\/DiffAttachment\/xcTest(_:)","kind":"symbol","fragments":[{"kind":"keyword","text":"case"},{"kind":"text","text":" "},{"kind":"identifier","text":"xcTest"},{"kind":"text","text":"("},{"kind":"typeIdentifier","text":"XCTAttachment","preciseIdentifier":"c:objc(cs)XCTAttachment"},{"kind":"text","text":")"}],"deprecated":true,"abstract":[]},"doc://SnapshotTesting/documentation/SnapshotTesting/Diffing":{"abstract":[{"text":"The ability to compare ","type":"text"},{"type":"codeVoice","code":"Value"},{"text":"s and convert them to and from ","type":"text"},{"type":"codeVoice","code":"Data"},{"text":".","type":"text"}],"navigatorTitle":[{"text":"Diffing","kind":"identifier"}],"identifier":"doc:\/\/SnapshotTesting\/documentation\/SnapshotTesting\/Diffing","url":"\/documentation\/snapshottesting\/diffing","fragments":[{"text":"struct","kind":"keyword"},{"text":" "
onformancePrefix":[{"text":"Conforms when","type":"text"}]},"role":"symbol","fragments":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"snapshots","kind":"identifier"},{"text":": ","kind":"text"},{"text":"_SnapshotsTestTrait","kind":"typeIdentifier"}],"title":"snapshots"},"doc://SnapshotTesting/documentation/SnapshotTesting/MigrationGuides":{"role":"article","identifier":"doc:\/\/SnapshotTesting\/documentation\/SnapshotTesting\/MigrationGuides","kind":"article","type":"topic","url":"\/documentation\/snapshottesting\/migrationguides","title":"Migration guides","abstract":[{"text":"Learn how to upgrade your application to the newest version of this library.","type":"text"}]}}}
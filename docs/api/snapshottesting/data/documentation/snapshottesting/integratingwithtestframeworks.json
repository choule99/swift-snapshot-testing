d":"text","text":": () "},{"kind":"keyword","text":"throws"},{"kind":"text","text":" -> "},{"kind":"typeIdentifier","text":"R"},{"kind":"text","text":") "},{"kind":"keyword","text":"rethrows"},{"kind":"text","text":" -> "},{"kind":"typeIdentifier","text":"R"}],"identifier":"doc:\/\/SnapshotTesting\/documentation\/SnapshotTesting\/withSnapshotTesting(record:diffTool:snapshotNaming:referenceStorage:locale:timeZone:calendar:operation:)","kind":"symbol","title":"withSnapshotTesting(record:diffTool:snapshotNaming:referenceStorage:locale:timeZone:calendar:operation:)","url":"\/documentation\/snapshottesting\/withsnapshottesting(record:difftool:snapshotnaming:referencestorage:locale:timezone:calendar:operation:)","abstract":[{"text":"Customizes ","type":"text"},{"code":"assertSnapshot","type":"codeVoice"},{"text":" for the duration of an operation.","type":"text"}]},"doc://SnapshotTesting/documentation/SnapshotTesting/Testing/Trait/snapshots":{"abstract":[{"type":"text","text":"Configure snapshot testing in a suite or test."}],"role":"symbol","fragments":[{"kind":"keyword","text":"static"},{"kind":"text","text":" "},{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"snapshots"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"_SnapshotsTestTrait"}],"identifier":"doc:\/\/SnapshotTesting\/documentation\/SnapshotTesting\/Testing\/Trait\/snapshots","kind":"symbol","title":"snapshots","url":"\/documentation\/snapshottesting\/testing\/trait\/snapshots","conformance":{"conformancePrefix":[{"type":"text","text":"Conforms when"}],"constraints":[{"code":"Self","type":"codeVoice"},{"type":"text","text":" is "},{"code":"_SnapshotsTestTrait","type":"codeVoice"},{"type":"text","text":"."}],"availabilityPrefix":[{"type":"text","text":"Available when"}]},"type":"topic"},"doc://SnapshotTesting/documentation/SnapshotTesting/SnapshotAssertionOptions":{"abstract":[{"type":"text","text":"Options that customize a snapshot assertion."}],"role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"SnapshotAssertionOptions"}],"identifier":"doc:\/\/SnapshotTesting\/documentation\/SnapshotTesting\/SnapshotAssertionOptions","kind":"symbol","title":"SnapshotAssertionOptions","url":"\/documentation\/snapshottesting\/snapshotassertionoptions","navigatorTitle":[{"kind":"identifier","text":"SnapshotAssertionOptions"}],"type":"topic"},"doc://SnapshotTesting/documentation/SnapshotTesting":{"role":"collection","identifier":"doc:\/\/SnapshotTesting\/documentation\/SnapshotTesting","url":"\/documentation\/snapshottesting","kind":"symbol","abstract":[{"text":"Powerfully flexible snapshot testing.","type":"text"}],"type":"topic","title":"SnapshotTesting"}}}
{"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/SnapshotTesting\/documentation\/SnapshotTesting\/SnapshotTestingConfiguration\/DiffTool-swift.struct"},"primaryContentSections":[{"declarations":[{"tokens":[{"text":"struct","kind":"keyword"},{"kind":"text","text":" "},{"text":"DiffTool","kind":"identifier"}],"languages":["swift"],"platforms":["macOS"]}],"kind":"declarations"},{"kind":"content","content":[{"level":2,"text":"Overview","anchor":"overview","type":"heading"},{"type":"paragraph","inlineContent":[{"type":"text","text":"This type can be created with a closure that takes two arguments: the first argument is"},{"text":" ","type":"text"},{"type":"text","text":"is a file path to the currently recorded snapshot on disk, and the second argument is the"},{"text":" ","type":"text"},{"type":"text","text":"file path to a "},{"inlineContent":[{"type":"text","text":"failed"}],"type":"emphasis"},{"text":" snapshot that was recorded to a temporary location on disk. You can","type":"text"},{"text":" ","type":"text"},{"text":"use these two file paths to construct a command that can be used to compare the two files.","type":"text"}]},{"inlineContent":[{"text":"For example, to use ImageMagick’s ","type":"text"},{"type":"codeVoice","code":"compare"},{"text":" tool and pipe the result into Preview.app, you","type":"text"},{"text":" ","type":"text"},{"text":"could create the following ","type":"text"},{"code":"DiffTool","type":"codeVoice"},{"text":":","type":"text"}],"type":"paragraph"},{"type":"codeListing","code":["extension SnapshotTestingConfiguration.DiffTool {","  static let compare = Self {","    \"compare \\\"\\($0)\\\" \\\"\\($1)\\\" png: | open -f -a Preview.app\"","  }","}"],"syntax":"swift"},{"inlineContent":[{"type":"codeVoice","code":"DiffTool"},{"type":"text","text":" also comes with two values: "},{"type":"reference","isActive":true,"identifier":"doc:\/\/SnapshotTesting\/documentation\/SnapshotTesting\/SnapshotTestingConfiguration\/DiffTool-swift.struct\
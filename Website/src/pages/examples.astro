---
import BaseLayout from "../layouts/BaseLayout.astro";
import CodeBlock from "../components/CodeBlock.astro";
const swiftTesting = `import SnapshotTesting
import Testing

@MainActor
struct SettingsTests {
  @Test func settings() {
    assertSnapshot(of: SettingsView(), as: .image)
  }
}`;
const xctest = `import SnapshotTesting
import XCTest

final class SettingsTests: XCTestCase {
  func testSettings() {
    assertSnapshot(of: SettingsView(), as: .image)
  }
}`;
const previews = `import SnapshotPreviews
import SwiftUI

struct ProfilePreview: PreviewProvider, SnapshotProvider {
  @SnapshotBuilder
  static var snapshots: [PreviewSnapshot] {
    PreviewSnapshot("Default") { ProfileView() }
  }
}`;
const previewTest = `@testable import MyFeature
import SnapshotTesting
import Testing

@MainActor
struct ProfileTests {
  @Test func profiles() {
    assertSnapshots(of: ProfilePreview.self)
  }
}`;
const inline = `import InlineSnapshotTesting

assertInlineSnapshot(of: user, as: .json) {
  """
  { "name" : "Blob" }
  """
}`;
const dump = `import SnapshotTestingCustomDump

assertSnapshot(of: response, as: .customDump)`;
---
<BaseLayout title="Examples" description="Examples for Swift Testing, XCTest, SwiftUI previews, inline snapshots, and CustomDump.">
  <section class="shell py-20 sm:py-28"><p class="eyebrow">Examples</p><h1 class="text-5xl font-bold tracking-[-0.05em]">The same assertion, different tests.</h1><p class="prose-copy mt-6">A strategy defines what the test stores and compares. Start with the examples closest to your code.</p></section>
  <article class="shell max-w-5xl space-y-16 pb-20"><section id="images" class="scroll-mt-8"><div class="grid gap-7 lg:grid-cols-2"><div><h2 class="text-3xl font-bold tracking-tight">Swift Testing</h2><p class="prose-copy mt-4">Use SnapshotTesting in a <code class="rounded bg-violet/10 px-1.5 py-0.5 text-sm text-indigo">@Test</code>. UI snapshots belong on the main actor.</p></div><CodeBlock code={swiftTesting} label="SettingsTests.swift" /></div></section><section><div class="grid gap-7 lg:grid-cols-2"><div><h2 class="text-3xl font-bold tracking-tight">XCTest</h2><p class="prose-copy mt-4">The assertion works in existing XCTest suites too. A test target can migrate one test at a time.</p></div><CodeBlock code={xctest} label="SettingsTests.swift" /></div></section><section id="previews" class="scroll-mt-8"><div><h2 class="text-3xl font-bold tracking-tight">SwiftUI previews</h2><p class="prose-copy mt-4">Define a preview once, then test that provider through SnapshotPreviews.</p></div><div class="mt-7 grid gap-5 lg:grid-cols-2"><CodeBlock code={previews} label="ProfilePreview.swift" /><CodeBlock code={previewTest} label="ProfileTests.swift" /></div></section><section id="formats" class="scroll-mt-8"><div class="grid gap-7 lg:grid-cols-2"><div><h2 class="text-3xl font-bold tracking-tight">Inline snapshots</h2><p class="prose-copy mt-4">For short text output, keep the expected result beside the assertion. The inline module can rewrite it when recording is enabled.</p></div><CodeBlock code={inline} label="UserTests.swift" /></div></section><section><div class="grid gap-7 lg:grid-cols-2"><div><h2 class="text-3xl font-bold tracking-tight">Custom dumps</h2><p class="prose-copy mt-4">Use the CustomDump strategy when a structural representation is more useful than JSON or a screenshot.</p></div><CodeBlock code={dump} label="ResponseTests.swift" /></div></section></article>
</BaseLayout>

---
const base = `${import.meta.env.BASE_URL}/`;
const pathname = Astro.url.pathname;
const links = [
  ["Documentation", `${base}documentation/`],
  ["Examples", `${base}examples/`],
  ["API reference", `${base}api/snapshottesting/documentation/snapshottesting/`],
] as const;
---
<header class="border-b border-line bg-paper/90 backdrop-blur">
  <nav class="shell flex min-h-18 flex-wrap items-center justify-between gap-4 py-4" aria-label="Main navigation">
    <a href={base} class="flex items-center gap-2 font-bold tracking-tight" aria-label="SnapshotTesting home">
      <span class="grid size-8 place-items-center rounded-lg bg-gradient-to-br from-indigo to-violet text-sm text-white">⌁</span>
      SnapshotTesting
    </a>
    <div class="order-3 flex w-full items-center justify-between gap-2 text-xs font-semibold text-muted sm:order-none sm:w-auto sm:gap-6 sm:text-sm">
      {links.map(([label, href]) => <a class:list={["transition hover:text-violet", { "text-indigo": pathname === href || (href.includes("documentation") && pathname.startsWith(`${base}documentation`)) }]} href={href}>{label}</a>)}
    </div>
    <a class="hidden rounded-lg px-3 py-2 text-sm font-semibold text-indigo transition hover:bg-violet/10 sm:block" href="https://github.com/modern-swift-dev/swift-snapshot-testing">GitHub ↗</a>
  </nav>
</header>

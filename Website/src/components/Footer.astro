---
const base = `${import.meta.env.BASE_URL}/`;
---
<footer class="mt-24 border-t border-line bg-white">
  <div class="shell grid gap-8 py-12 sm:grid-cols-[1fr_auto]">
    <div>
      <a href={base} class="font-bold">SnapshotTesting</a>
      <p class="mt-2 max-w-md text-sm leading-6 text-muted">Snapshot testing for Swift projects. Maintained by Modern Swift Development.</p>
    </div>
    <div class="flex gap-5 text-sm font-semibold text-muted">
      <a class="hover:text-violet" href={`${base}documentation/`}>Docs</a>
      <a class="hover:text-violet" href={`${base}examples/`}>Examples</a>
      <a class="hover:text-violet" href="https://github.com/modern-swift-dev/swift-snapshot-testing">GitHub</a>
    </div>
  </div>
</footer>

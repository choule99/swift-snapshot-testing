---
import type { Release } from "../lib/release";
interface Props { release: Release; }
const { release } = Astro.props;
---
<aside class="surface relative overflow-hidden p-6" aria-label="Latest release">
  <div class="absolute -top-12 -right-10 size-36 rounded-full bg-violet/10 blur-2xl"></div>
  <p class="font-mono text-xs font-bold tracking-[0.14em] text-violet uppercase">Latest release</p>
  <p class="mt-3 text-3xl font-bold tracking-tight">{release.tag}</p>
  <p class="mt-1 text-sm text-muted">Published {release.date}</p>
  <code class="mt-5 block rounded-lg bg-violet/8 px-3 py-2 text-sm text-indigo">.upToNextMajor(from: "{release.version}")</code>
  <a class="mt-5 inline-block text-sm font-bold text-indigo hover:text-violet" href={release.url}>Release notes ↗</a>
</aside>
